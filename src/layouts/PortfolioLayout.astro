---
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/portfolio/Nav.astro';
import { ui } from '../i18n/ui';
import type { Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const { lang = 'en', ...rest } = Astro.props;
const tr = ui[lang];
const { title = tr.site.title, description = tr.site.description } = rest;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={tr.htmlLang}>
  <head>
    <BaseHead title={title} description={description} showAlternates={true} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://www.petarbuilds.tech/#person",
          "name": "Petar Jovanovic",
          "jobTitle": "Senior Web Developer",
          "description": "Senior Web Developer specializing in React, Next.js, TypeScript, and scalable SaaS products. 7+ years building fintech, enterprise, and startup software.",
          "url": "https://www.petarbuilds.tech",
          "email": "petarbuilds.tech@gmail.com",
          "sameAs": [
            "https://www.linkedin.com/in/petar-jovanovic-231a52135",
            "https://github.com/petarchord"
          ],
          "knowsAbout": [
            "TypeScript", "React", "Next.js", "Node.js", "Software Engineering",
            "SaaS", "Fintech", "Design Systems", "Frontend Architecture"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://www.petarbuilds.tech/#website",
          "url": "https://www.petarbuilds.tech",
          "name": "petarbuilds.tech",
          "description": "Portfolio and services of Petar Jovanovic — Senior Web Developer",
          "author": { "@id": "https://www.petarbuilds.tech/#person" }
        },
        {
          "@type": "ProfessionalService",
          "name": "petarbuilds.tech",
          "url": "https://www.petarbuilds.tech",
          "description": "Web development, technical consulting, and product modernization by Petar Jovanovic.",
          "founder": { "@id": "https://www.petarbuilds.tech/#person" },
          "serviceType": [
            "Web Application Development", "SaaS Development",
            "Frontend Engineering", "Technical Consulting", "MVP Development"
          ]
        }
      ]
    })} />
  </head>
  <body>
    <Nav lang={lang} />
    <slot />

    <footer class="border-t border-white/[0.06] px-6 py-12 mt-32">
      <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div>
          <div class="flex items-center gap-2.5 mb-1">
            <svg width="18" height="18" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect x="3" y="14" width="16" height="3" rx="1.5" fill="#818cf8"/>
              <rect x="3" y="9"  width="16" height="3" rx="1.5" fill="#818cf8" opacity="0.6"/>
              <rect x="3" y="4"  width="16" height="3" rx="1.5" fill="#818cf8" opacity="0.3"/>
            </svg>
            <span class="text-sm font-semibold tracking-tight leading-none">
              <span class="text-white">petar</span><span class="text-[#818cf8]">builds</span><span class="text-[#444] font-mono text-[11px]">.tech</span>
            </span>
          </div>
          <p class="text-[#555] text-sm">{tr.footer.tagline}</p>
        </div>
        <div class="flex items-center gap-5">
          <a
            href="https://www.linkedin.com/in/petar-jovanovic-231a52135"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
            class="text-[#555] hover:text-white transition-colors duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a
            href="https://github.com/petarchord"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
            class="text-[#555] hover:text-white transition-colors duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <a
            href="mailto:petarbuilds.tech@gmail.com"
            aria-label="Email"
            class="text-[#555] hover:text-white transition-colors duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </a>
          <span class="text-[#3f3f46] text-xs font-mono pl-4 border-l border-white/[0.06]">© {year}</span>
        </div>
      </div>
    </footer>

    <script>
      // Scroll-reveal: watch [data-reveal] elements and add .in-view when visible
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              (entry.target as HTMLElement).classList.add('in-view');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
