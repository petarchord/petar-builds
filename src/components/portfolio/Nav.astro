---
const navLinks = [
  { href: '/#hero',     label: 'Home',     section: 'hero' },
  { href: '/#about',    label: 'About',    section: 'about' },
  { href: '/#work',     label: 'Work',     section: 'work' },
  { href: '/#services', label: 'Services', section: 'services' },
  { href: '/#writing',  label: 'Writing',  section: 'writing' },
  { href: '/#contact',  label: 'Contact',  section: 'contact' },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <nav class="max-w-6xl mx-auto px-6 xl:px-0 py-5 flex items-center justify-between">
    <a
      href="/#hero"
      class="text-white font-semibold text-sm tracking-tight hover:opacity-70 transition-opacity duration-200"
    >
      Petar Jovanović
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-1">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            data-nav-link={link.section}
            class="nav-link text-sm px-3 py-1.5 rounded-md transition-colors duration-200 text-[#888] hover:text-white"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile menu toggle -->
    <button
      id="menu-toggle"
      class="md:hidden text-[#888] hover:text-white transition-colors duration-200 p-1"
      aria-label="Toggle navigation menu"
    >
      <svg
        id="menu-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <svg
        id="close-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="hidden"
      >
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-white/[0.06] px-6 py-5 bg-[#09090b]"
  >
    <ul class="flex flex-col gap-1">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            data-nav-link={link.section}
            class="nav-link block text-sm px-3 py-2 rounded-md transition-colors duration-200 text-[#888] hover:text-white"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  // ── Header blur on scroll ──────────────────────────────────
  const header = document.getElementById('site-header') as HTMLElement;
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  const updateHeader = () => {
    if (window.scrollY > 20) {
      header.style.background = 'rgba(9, 9, 11, 0.88)';
      header.style.backdropFilter = 'blur(14px)';
      header.style.borderBottom = '1px solid rgba(255,255,255,0.05)';
    } else {
      header.style.background = 'transparent';
      header.style.backdropFilter = 'none';
      header.style.borderBottom = 'none';
    }
  };

  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();

  menuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });

  // ── Scroll-based active nav link ──────────────────────────
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

  const setActive = (sectionId: string) => {
    navLinks.forEach((link) => {
      const isActive = link.getAttribute('data-nav-link') === sectionId;
      link.classList.toggle('text-white', isActive);
      link.classList.toggle('bg-white/[0.08]', isActive);
      link.classList.toggle('text-[#888]', !isActive);
    });
  };

  const sections: { id: string; el: HTMLElement }[] = [];
  navLinks.forEach((link) => {
    const id = link.getAttribute('data-nav-link')!;
    const el = document.getElementById(id);
    if (el) sections.push({ id, el });
  });

  const onScroll = () => {
    // Walk from bottom to top: last section whose top is above the midpoint wins
    let current = sections[0]?.id ?? '';
    for (const { id, el } of sections) {
      if (el.getBoundingClientRect().top <= window.innerHeight * 0.45) {
        current = id;
      }
    }
    setActive(current);
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll(); // set initial active on page load
</script>

