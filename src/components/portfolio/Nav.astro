---
import { ui } from '../../i18n/ui';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const tr = ui[lang];
const prefix = lang === 'sr' ? '/sr' : '';

const navLinks = [
  { href: `${prefix}/#hero`,     label: tr.nav.home,     section: 'hero' },
  { href: `${prefix}/#about`,    label: tr.nav.about,    section: 'about' },
  { href: `${prefix}/#work`,     label: tr.nav.work,     section: 'work' },
  { href: `${prefix}/#services`, label: tr.nav.services, section: 'services' },
  { href: `${prefix}/#writing`,  label: tr.nav.writing,  section: 'writing' },
  { href: `${prefix}/#contact`,  label: tr.nav.contact,  section: 'contact' },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <nav class="max-w-6xl mx-auto px-6 xl:px-0 py-5 flex items-center justify-between">
    <a
      href="/#hero"
      class="hover:opacity-80 transition-opacity duration-200 flex items-center gap-2.5"
      aria-label="petarbuilds.tech — home"
    >
      <!-- Mark: stacked layers representing "builds" -->
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="3" y="14" width="16" height="3" rx="1.5" fill="#818cf8"/>
        <rect x="3" y="9"  width="16" height="3" rx="1.5" fill="#818cf8" opacity="0.6"/>
        <rect x="3" y="4"  width="16" height="3" rx="1.5" fill="#818cf8" opacity="0.3"/>
      </svg>
      <!-- Wordmark -->
      <span class="text-sm font-semibold tracking-tight leading-none">
        <span class="text-white">petar</span><span class="text-[#818cf8]">builds</span><span class="text-[#444] font-mono text-[11px]">.tech</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-1">
      <ul class="flex items-center gap-1">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              data-nav-link={link.section}
              class="nav-link text-sm px-3 py-1.5 rounded-md transition-colors duration-200 text-[#888] hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <!-- Language switcher -->
      <a
        href={tr.nav.switchToHref}
        aria-label={tr.nav.switchToLabel}
        class="ml-2 text-xs font-mono text-[#555] hover:text-white border border-white/[0.08] hover:border-white/20 px-2.5 py-1.5 rounded-md transition-colors duration-200"
      >
        {tr.nav.switchTo}
      </a>
      <a
        href="https://calendly.com/petarbuilds-tech/30min"
        target="_blank"
        rel="noopener noreferrer"
        class="ml-2 inline-flex items-center gap-2 bg-[#818cf8] text-white text-sm font-semibold px-4 py-1.5 rounded-lg hover:bg-[#6366f1] transition-colors duration-200"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        {tr.nav.bookCall}
      </a>
    </div>

    <!-- Mobile menu toggle -->
    <button
      id="menu-toggle"
      class="md:hidden text-[#888] hover:text-white transition-colors duration-200 p-1"
      aria-label="Toggle navigation menu"
    >
      <svg
        id="menu-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <svg
        id="close-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="hidden"
      >
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-white/[0.06] px-6 py-5 bg-[#09090b]"
  >
    <ul class="flex flex-col gap-1 mb-4">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            data-nav-link={link.section}
            class="nav-link block text-sm px-3 py-2 rounded-md transition-colors duration-200 text-[#888] hover:text-white"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <!-- Language switcher + CTA (mobile) -->
    <div class="flex items-center gap-3">
    <a
      href={tr.nav.switchToHref}
      aria-label={tr.nav.switchToLabel}
      class="inline-flex items-center text-xs font-mono text-[#555] hover:text-white border border-white/[0.08] hover:border-white/20 px-3 py-2.5 rounded-md transition-colors duration-200"
    >
      {tr.nav.switchTo}
    </a>
    <a
      href="https://calendly.com/petarbuilds-tech/30min"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 bg-[#818cf8] text-white text-sm font-semibold px-4 py-2.5 rounded-lg hover:bg-[#6366f1] transition-colors duration-200"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/>
        <line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
      {tr.nav.bookCall}
    </a>
    </div>
  </div>
</header>

<script>
  // ── Header blur on scroll ──────────────────────────────────
  const header = document.getElementById('site-header') as HTMLElement;
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  const updateHeader = () => {
    if (window.scrollY > 20) {
      header.style.background = 'rgba(9, 9, 11, 0.88)';
      header.style.backdropFilter = 'blur(14px)';
      header.style.borderBottom = '1px solid rgba(255,255,255,0.05)';
    } else {
      header.style.background = 'transparent';
      header.style.backdropFilter = 'none';
      header.style.borderBottom = 'none';
    }
  };

  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();

  menuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });

  // ── Scroll-based active nav link ──────────────────────────
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

  const setActive = (sectionId: string) => {
    navLinks.forEach((link) => {
      const isActive = link.getAttribute('data-nav-link') === sectionId;
      link.classList.toggle('text-white', isActive);
      link.classList.toggle('bg-white/[0.08]', isActive);
      link.classList.toggle('text-[#888]', !isActive);
    });
  };

  const sections: { id: string; el: HTMLElement }[] = [];
  navLinks.forEach((link) => {
    const id = link.getAttribute('data-nav-link')!;
    const el = document.getElementById(id);
    if (el) sections.push({ id, el });
  });

  const onScroll = () => {
    // Walk from bottom to top: last section whose top is above the midpoint wins
    let current = sections[0]?.id ?? '';
    for (const { id, el } of sections) {
      if (el.getBoundingClientRect().top <= window.innerHeight * 0.45) {
        current = id;
      }
    }
    setActive(current);
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll(); // set initial active on page load
</script>

