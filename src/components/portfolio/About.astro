---
---

<section id="about" class="py-24 px-6 scroll-mt-20">
  <div class="max-w-5xl mx-auto">
    <p class="text-[#818cf8] text-xs font-mono tracking-[0.3em] uppercase mb-3 opacity-80">
      01 — About
    </p>
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-16 leading-tight">
      Profile
    </h2>

    <div class="grid md:grid-cols-5 gap-12 lg:gap-20">
      <!-- Bio -->
      <div class="md:col-span-3 space-y-5 text-[#a1a1aa] leading-relaxed text-base">
        <p>
          Senior Software Engineer with 7+ years of experience specializing in
          frontend engineering and building scalable software products that align
          with business objectives.
        </p>
        <p>
          I've delivered production software across both enterprise and startup
          environments, including platforms for Fortune Global 500 companies,
          spanning fintech, enterprise accounting, e-commerce, social networks,
          HR, affiliate marketing, and entertainment.
        </p>
        <p>
          My expertise includes designing scalable frontend architectures,
          building shared component libraries and design systems, improving
          developer experience, and delivering high-performance user interfaces
          using modern React and TypeScript ecosystems.
        </p>
      </div>

      <!-- Contact sidebar -->
      <div class="md:col-span-2 space-y-8">
        <div>
          <h3 class="text-[#52525b] text-xs font-mono tracking-[0.2em] uppercase mb-5">
            Contact
          </h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3.5">
              <span class="text-[#818cf8] mt-0.5 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </span>
              <span class="text-[#a1a1aa] text-sm">Niš, Serbia</span>
            </li>
            <li class="flex items-start gap-3.5">
              <span class="text-[#818cf8] mt-0.5 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="20" height="16" x="2" y="4" rx="2"/>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
              </span>
              <a
                href="mailto:petarchord@gmail.com"
                class="text-[#a1a1aa] hover:text-white text-sm transition-colors duration-200"
              >
                petarchord@gmail.com
              </a>
            </li>
            <li class="flex items-start gap-3.5">
              <span class="text-[#818cf8] mt-0.5 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.62 3h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 10.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17.92Z"/>
                </svg>
              </span>
              <a
                href="tel:+381645477689"
                class="text-[#a1a1aa] hover:text-white text-sm transition-colors duration-200"
              >
                +381 64 547 7689
              </a>
            </li>
          </ul>
        </div>

        <!-- Languages -->
        <div class="pt-6 border-t border-white/5">
          <h3 class="text-[#52525b] text-xs font-mono tracking-[0.2em] uppercase mb-5">
            Languages
          </h3>
          <ul class="space-y-3">
            <li class="flex items-center justify-between">
              <span class="text-[#a1a1aa] text-sm">Serbian</span>
              <span class="text-[#3f3f46] text-xs font-mono">Native</span>
            </li>
            <li class="flex items-center justify-between">
              <span class="text-[#a1a1aa] text-sm">English</span>
              <span class="text-[#3f3f46] text-xs font-mono">Fluent</span>
            </li>
          </ul>
        </div>

        <!-- Hobbies -->
        <div class="pt-6 border-t border-white/5">
          <h3 class="text-[#52525b] text-xs font-mono tracking-[0.2em] uppercase mb-5">
            Outside Work
          </h3>
          <p class="text-[#a1a1aa] text-sm">Singer in a band</p>
        </div>
      </div>
    </div>
  </div>
</section>
