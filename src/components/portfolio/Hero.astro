---
---

<section class="min-h-screen flex items-center pt-20 pb-16 px-6">
  <div class="max-w-5xl mx-auto w-full">
    <p class="text-[#818cf8] text-xs font-mono tracking-[0.3em] uppercase mb-8 opacity-80">
      Hello, I'm
    </p>

    <h1 class="font-bold text-white leading-none tracking-tight mb-6">
      <span class="block text-[clamp(3rem,10vw,5.5rem)]">Petar</span>
      <span
        class="block text-[clamp(3rem,10vw,5.5rem)] text-transparent bg-clip-text"
        style="background-image: linear-gradient(135deg, #818cf8 0%, #c084fc 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"
      >
        Jovanovic
      </span>
    </h1>

    <p class="text-xl md:text-2xl text-[#71717a] mb-5 font-light tracking-wide">
      Senior Software Engineer
    </p>

    <p class="text-[#a1a1aa] max-w-lg mb-12 text-base leading-relaxed">
      7+ years building scalable frontend products across fintech, enterprise,
      and startups. Specialized in React, TypeScript, and modern frontend
      architecture.
    </p>

    <div class="flex flex-wrap gap-4">
      <a
        href="#experience"
        class="bg-[#818cf8] hover:bg-[#6366f1] text-white px-7 py-3 rounded-lg text-sm font-medium transition-colors duration-200"
      >
        View Work
      </a>
      <a
        href="#contact"
        class="border border-white/10 hover:border-white/20 text-[#a1a1aa] hover:text-white px-7 py-3 rounded-lg text-sm font-medium transition-colors duration-200"
      >
        Get in Touch
      </a>
    </div>

    <!-- Scroll indicator -->
    <div class="mt-24 flex items-center gap-3 text-[#3f3f46]">
      <div class="w-8 h-px bg-[#3f3f46]"></div>
      <span class="text-xs font-mono tracking-[0.3em] uppercase">Scroll</span>
    </div>
  </div>
</section>
