---
type Project = {
  title: string;
  description: string;
  stack: string[];
};

type Experience = {
  company: string;
  role: string;
  badge?: string;
  period: string;
  projectTitle?: string;
  bullets?: string[];
  stack?: string[];
  projects?: Project[];
};

const experiences: Experience[] = [
  {
    company: 'Paayed',
    role: 'Senior Software Engineer',
    badge: 'Contractor',
    period: 'Jun 2025 – Present',
    projectTitle: 'All-in-One B2B Fintech Operating Platform for UK SMEs',
    bullets: [
      'Designed and led the development of a shared React component library and design system, establishing frontend standards and scalable architecture that improved UI consistency, accelerated development, and reduced long-term maintenance costs.',
      'Delivered key fintech functionality including secure cookie/session authentication (Laravel Sanctum), 3D Secure payment flows, hosted payment page integration, real-time analytics dashboards, reporting, Admin & Client CRM, and accounting modules (Invoices, Quotes, Credit Notes, Expenses).',
    ],
    stack: ['TypeScript', 'React', 'Tailwind CSS', 'Radix UI', 'RTL', 'Jest', 'GitHub CI/CD'],
  },
  {
    company: 'Symphony',
    role: 'Software Developer',
    period: 'Sep 2022 – Dec 2024',
    projectTitle: 'Enterprise Micro-Frontend Platform — Fortune Global 500',
    bullets: [
      'Successfully delivered a Micro-Frontend (MFE) web application supporting article production workflows between worldwide suppliers and quality assurance teams.',
      'Built and maintained a shared internal UI component library published as an npm package, enabling consistent design and faster development across more than 10 engineering teams.',
    ],
    stack: ['TypeScript', 'React', 'RTL', 'Jest', 'Stryker.js', 'Docker', 'AWS', 'Azure'],
  },
  {
    company: 'Devtech',
    role: 'Software Developer',
    period: 'Aug 2021 – Sep 2022',
    projects: [
      {
        title: 'Enterprise Accounting Platform (USA)',
        description:
          'Modernized a legacy accounting platform into a scalable, high-performance solution. Delivered financial reporting dashboards, lease accounting workflows, large data tables with advanced filtering, export functionality, and high-performance financial UI.',
        stack: ['TypeScript', 'Next.js', 'Redux Toolkit', 'Redux Saga', 'ASP.NET', 'PostgreSQL', 'AWS'],
      },
      {
        title: 'AI-Powered Digital Enablement Platform',
        description:
          'Contributed to a platform helping thousands of organizations maximize Microsoft 365 adoption. Led the release of an advanced version featuring complex big-data visualizations built with custom D3.js chart components.',
        stack: ['TypeScript', 'React', 'D3.js', 'Material UI', 'Azure Cosmos DB', 'Azure SQL', 'ASP.NET'],
      },
      {
        title: 'Internal Learning Platform',
        description:
          'Built and released an internal platform used by hundreds of employees to learn, collaborate, and share knowledge.',
        stack: ['TypeScript', 'React', 'Redux Toolkit', 'Redux Thunk', 'Material UI', 'Firebase', 'Google APIs'],
      },
      {
        title: 'HR CRM Platform',
        description:
          'Developed the administration panel for employee management and skills tracking, enabling efficient employee placement and visibility into technical expertise.',
        stack: ['TypeScript', 'Next.js', 'Redux Toolkit', 'Redux Thunk', 'Material UI'],
      },
      {
        title: 'Booking Platform (USA)',
        description:
          'Developed a full-stack marketplace connecting service providers and consumers. Implemented service discovery, booking, authentication, and management functionality.',
        stack: ['TypeScript', 'Next.js', 'Prisma', 'PostgreSQL', 'Auth0', 'Docker', 'AWS', 'Calendly API'],
      },
    ],
  },
  {
    company: 'Lioneve Media',
    role: 'Software Developer',
    period: 'Dec 2020 – Aug 2021',
    projects: [
      {
        title: 'Fitcher — Social & Content Subscription Platform',
        description:
          'Built the platform from greenfield to beta. Implemented Instagram-like Stories, creator subscriptions, user profiles, creator profiles, and core social networking functionality.',
        stack: ['TypeScript', 'Next.js', 'Redux', 'Node.js', 'MongoDB'],
      },
      {
        title: 'Magic Unbox — Entertainment Platform',
        description:
          'Enhanced a full-stack platform by implementing payment processing, email workflows, promotional logic, and probability engine improvements.',
        stack: ['TypeScript', 'React', 'Node.js', 'MySQL'],
      },
    ],
  },
  {
    company: 'Boopro',
    role: 'Software Developer',
    period: 'Jan 2020 – Oct 2020',
    projectTitle: 'Bridge TV — Smart TV Platform',
    bullets: [
      'Built the Smart TV interface from scratch for Samsung and LG devices. Implemented robust player controls and optimized the entire experience for television platforms.',
    ],
    stack: ['TypeScript', 'React', 'Redux', 'PHP', 'MySQL'],
  },
  {
    company: 'Permanentum',
    role: 'Head of Software and Support',
    period: 'Jan 2019 – Dec 2019',
    bullets: [
      'Delivered an affiliate marketing platform from the ground up while helping define the system architecture and core application structure.',
      'Implemented an Ethereum-based position purchase system, subscription functionality, referral and invitation system, multi-level affiliate reward logic, and large-scale referral tree visualizations supporting thousands of descendants.',
    ],
    stack: ['TypeScript', 'React', 'Node.js', 'MySQL'],
  },
];
---

<section id="experience" class="py-24 px-6 scroll-mt-20">
  <div class="max-w-5xl mx-auto">
    <p class="text-[#818cf8] text-xs font-mono tracking-[0.3em] uppercase mb-3 opacity-80">
      03 — Experience
    </p>
    <h2 class="text-3xl md:text-4xl font-bold text-white mb-16 leading-tight">
      Work History
    </h2>

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical guide line -->
      <div
        class="absolute left-0 top-2 bottom-0 w-px bg-gradient-to-b from-[#818cf8]/30 via-white/5 to-transparent hidden md:block"
      ></div>

      <div class="space-y-16">
        {experiences.map((exp) => (
          <div class="relative md:pl-10">
            <!-- Timeline dot -->
            <div class="absolute -left-[3px] top-1.5 w-1.5 h-1.5 rounded-full bg-[#818cf8] hidden md:block ring-4 ring-[#09090b]"></div>

            <!-- Header -->
            <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-6">
              <div>
                <div class="flex items-center gap-2.5 mb-1">
                  <h3 class="text-white font-semibold text-lg leading-snug">
                    {exp.company}
                  </h3>
                  {exp.badge && (
                    <span class="text-[10px] text-[#818cf8] border border-[#818cf8]/30 px-2 py-0.5 rounded-full font-mono tracking-wide">
                      {exp.badge}
                    </span>
                  )}
                </div>
                <p class="text-[#818cf8] text-sm">{exp.role}</p>
              </div>
              <span class="text-[#52525b] text-xs font-mono whitespace-nowrap mt-0.5">
                {exp.period}
              </span>
            </div>

            <!-- Single-project entry -->
            {exp.bullets && (
              <div>
                {exp.projectTitle && (
                  <p class="text-white/60 text-sm font-medium mb-4 italic">
                    {exp.projectTitle}
                  </p>
                )}
                <ul class="space-y-3 mb-6">
                  {exp.bullets.map((bullet) => (
                    <li class="flex gap-3 text-[#a1a1aa] text-sm leading-relaxed">
                      <span class="text-[#818cf8] shrink-0 mt-1.5">
                        <svg width="6" height="6" viewBox="0 0 6 6" fill="currentColor">
                          <circle cx="3" cy="3" r="3"/>
                        </svg>
                      </span>
                      {bullet}
                    </li>
                  ))}
                </ul>
                {exp.stack && (
                  <div class="flex flex-wrap gap-2">
                    {exp.stack.map((tech) => (
                      <span class="text-[11px] text-[#71717a] bg-white/3 border border-white/6 px-2.5 py-1 rounded-md font-mono">
                        {tech}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            )}

            <!-- Multi-project entry -->
            {exp.projects && (
              <div class="space-y-6">
                {exp.projects.map((proj) => (
                  <div class="border-l-2 border-white/6 pl-5 hover:border-[#818cf8]/40 transition-colors duration-300">
                    <p class="text-white/70 text-sm font-medium mb-2">
                      {proj.title}
                    </p>
                    <p class="text-[#a1a1aa] text-sm leading-relaxed mb-4">
                      {proj.description}
                    </p>
                    <div class="flex flex-wrap gap-2">
                      {proj.stack.map((tech) => (
                        <span class="text-[11px] text-[#71717a] bg-white/3 border border-white/6 px-2.5 py-1 rounded-md font-mono">
                          {tech}
                        </span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
