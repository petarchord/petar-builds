---
import { Image } from 'astro:assets';
import PaayedLogo from '../../assets/Paayed-logo.png';
import InditexLogo from '../../assets/Inditex-logo.webp';
import FinqueryLogo from '../../assets/Finquery-logo.webp';
import SymphonyLogo from '../../assets/Symphony-logo.png';
import DevtechLogo from '../../assets/Devtech-logo.png';
import NuliaLogo from '../../assets/Nulia-logo.png';
import FitcherLogo from '../../assets/Fitcher-logo.png';

interface Props {
  label?: string;
  class?: string;
}
const { label = 'Worked with', class: className = '' } = Astro.props;

const logos = [
  { name: 'Paayed',   src: PaayedLogo,   type: 'solid' },
  { name: 'Inditex',  src: InditexLogo,  type: 'solid' },
  { name: 'FinQuery', src: FinqueryLogo, type: 'transparent' },
  { name: 'Symphony', src: SymphonyLogo, type: 'transparent' },
  { name: 'Devtech',  src: DevtechLogo,  type: 'transparent' },
  { name: 'Nulia',    src: NuliaLogo,    type: 'solid' },
  { name: 'Fitcher',  src: FitcherLogo,  type: 'transparent' },
];
---

<div class={`worked-with-strip ${className}`}>
  <p class="text-[#80808a] text-xs font-mono tracking-[0.25em] uppercase mb-5">{label}</p>
  <div
    class="marquee-outer relative overflow-hidden"
    style="mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);"
  >
    <div class="marquee-track flex w-max items-center">
      {[...logos, ...logos].map((logo) => (
        <div class="flex items-center shrink-0">
          <Image
            src={logo.src}
            alt={logo.name}
            height={52}
            class={`logo-${logo.type}`}
            draggable="false"
          />
          <span class="text-[#1e1e22] select-none px-8 text-xs" aria-hidden="true">/</span>
        </div>
      ))}
    </div>
  </div>
</div>
