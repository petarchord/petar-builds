---
import PaayedLogo from '../../assets/Paayed-logo.png';
import InditexLogo from '../../assets/Inditex-logo.webp';
import FinqueryLogo from '../../assets/Finquery-logo.webp';
import SymphonyLogo from '../../assets/Symphony-logo.png';
import DevtechLogo from '../../assets/Devtech-logo.png';
import NuliaLogo from '../../assets/Nulia-logo.png';

// type: 'solid'       = coloured/dark artwork on a white background
// type: 'transparent' = white artwork on a transparent background
const logos = [
  { name: 'Paayed',   src: PaayedLogo.src,   type: 'solid' },
  { name: 'Inditex',  src: InditexLogo.src,  type: 'solid' },
  { name: 'FinQuery', src: FinqueryLogo.src, type: 'transparent' },
  { name: 'Symphony', src: SymphonyLogo.src, type: 'transparent' },
  { name: 'Devtech',  src: DevtechLogo.src,  type: 'transparent' },
  { name: 'Nulia',    src: NuliaLogo.src,    type: 'solid' },
];

const stats = [
  { value: '7+',    label: 'Years of experience' },
  { value: '3',     label: 'Startups built from the ground up' },
  { value: '10+',   label: 'Production projects' },
  { value: '100K+', label: 'Users impacted' },
];
---

<section class="border-t border-white/[0.06] px-6 py-20">
  <div class="max-w-6xl mx-auto">

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 mb-14">
      {stats.map(({ value, label }, i) => (
        <div data-reveal style={`transition-delay:${i * 60}ms`}>
          <p class="text-3xl md:text-4xl font-bold text-white tracking-tight mb-1">{value}</p>
          <p class="text-[#555] text-sm">{label}</p>
        </div>
      ))}
    </div>

  </div>

  <!-- Worked with: logo marquee (full-width, outside the max-w container) -->
  <div data-reveal class="mt-4">
    <p class="text-center text-[#3f3f46] text-xs font-mono tracking-[0.25em] uppercase mb-10">
      Worked with
    </p>

    <div
      class="marquee-outer relative overflow-hidden"
      style="mask-image: linear-gradient(to right, transparent 0%, black 14%, black 86%, transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 14%, black 86%, transparent 100%);"
    >
      <!-- Track: two identical copies for a seamless infinite loop -->
      <div class="marquee-track flex w-max items-center gap-0">
        {[...logos, ...logos].map((logo) => (
          <div class="flex items-center shrink-0">
            <img
              src={logo.src}
              alt={logo.name}
              class={`logo-${logo.type}`}
              draggable="false"
            />
            <span class="text-[#1e1e22] select-none px-10 text-xs" aria-hidden="true">
              /
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
