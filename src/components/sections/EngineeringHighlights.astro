---
import WorkedWith from './WorkedWith.astro';

const services = [
  {
    number: '01',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
    title: 'Build Your Product',
    tagline: 'From idea to production-ready software.',
    body: "Whether you're validating a new idea, launching an MVP, or scaling an existing product, I will help you transform your vision into a scalable web solution with a strong technical foundation, clean architecture, and maintainable code. AI accelerates my development workflow—so you ship faster without compromising quality.",
    outcomes: [
      'Production-ready MVP or SaaS application',
      'Scalable architecture that grows with your business',
      'Faster time-to-market without sacrificing quality',
      'Clean, maintainable code built for long-term success',
    ],
  },
  {
    number: '02',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 1 7 7c0 2.97-1.85 5.52-4.5 6.57V17a1 1 0 0 1-1 1h-3a1 1 0 0 1-1-1v-1.43C6.85 14.52 5 11.97 5 9a7 7 0 0 1 7-7z"/></svg>`,
    title: 'Technical Consulting',
    tagline: 'Solve the problems slowing your team down.',
    body: 'Need a second opinion on the front-end architecture, performance bottlenecks, scalability or some other type of complexity? I help teams identify root causes, make informed technical decisions, and define a clear path forward.',
    outcomes: [
      'Clear diagnosis of bottlenecks and technical debt',
      'Actionable architecture and performance recommendations',
      'Informed decisions on tech stack and tooling',
      'A defined path forward for your team',
    ],
  },
  {
    number: '03',
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>`,
    title: 'Modernize & Scale',
    tagline: 'Improve what already works.',
    body: "Legacy applications don't always need a rewrite. I help teams modernize codebases, introduce scalable architecture, establish design systems, improve performance, and reduce long-term maintenance costs without disrupting product development.",
    outcomes: [
      'Legacy codebase modernized without service disruption',
      'Scalable architecture and established design system',
      'Improved performance and Core Web Vitals',
      'Reduced maintenance costs and technical debt',
    ],
  },
];
---

<section id="services" class="px-6 py-32">
  <div class="max-w-6xl mx-auto">
    <div data-reveal class="mb-14">
      <p class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase mb-4">My Services</p>
      <h2 class="text-3xl md:text-[2.5rem] font-bold text-white tracking-tight leading-tight">
        How I can help
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-4">
      {services.map(({ number, icon, title, tagline, body, outcomes }, i) => (
        <div
          data-reveal
          style={`transition-delay:${i * 80}ms`}
          class="service-card group relative border border-white/[0.06] rounded-xl p-8 hover:border-white/[0.12] hover:bg-white/[0.02] transition-all duration-300 flex flex-col"
        >
          <!-- Animated top-glow border on hover -->
          <span class="service-glow" aria-hidden="true" />

          <!-- Icon + number row -->
          <div class="flex items-center justify-between mb-6">
            <span
              class="service-icon flex items-center justify-center w-10 h-10 rounded-lg bg-white/[0.04] border border-white/[0.06] text-[#818cf8] group-hover:bg-[#818cf8]/10 group-hover:border-[#818cf8]/20 transition-all duration-300"
              set:html={icon}
            />
            <span class="text-[#333] text-xs font-mono">{number}</span>
          </div>

          <h3 class="text-white font-semibold text-lg mb-2">{title}</h3>
          <p class="text-[#818cf8] text-sm font-medium mb-4">{tagline}</p>
          <p class="text-[#666] text-sm leading-relaxed mb-6">{body}</p>

          <!-- Outcomes -->
          <div class="mt-auto pt-6 border-t border-white/[0.05]">
            <ul class="space-y-2.5">
              {outcomes.map((outcome, j) => (
                <li
                  class="outcome-item flex items-start gap-2.5 text-sm text-[#555]"
                  style={`--delay:${(i * 80) + (j * 60) + 200}ms`}
                >
                  <span class="text-[#818cf8] shrink-0 mt-px text-xs">✓</span>
                  <span class="group-hover:text-[#777] transition-colors duration-200">{outcome}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <!-- CTAs -->
    <div data-reveal class="mt-14 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="https://calendly.com/petarbuilds-tech/30min"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 bg-[#818cf8] text-white text-sm font-semibold px-6 py-3.5 rounded-lg hover:bg-[#6366f1] transition-colors duration-200"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        Book a free call
      </a>
      <a
        href="/#work"
        class="inline-flex items-center gap-2 border border-white/10 text-white text-sm font-medium px-6 py-3.5 rounded-lg hover:border-white/20 hover:bg-white/[0.04] transition-colors duration-200"
      >
        See my work <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- Social proof strip -->
    <div data-reveal class="mt-16 pt-12 border-t border-white/[0.06]">
      <WorkedWith label="Trusted by teams at" />
    </div>

  </div>
</section>

<style>
  /* Gradient top-line that slides in on hover */
  .service-glow {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 1px;
    border-radius: 0.75rem 0.75rem 0 0;
    background: linear-gradient(90deg, transparent 0%, rgba(129, 140, 248, 0.7) 50%, transparent 100%);
    opacity: 0;
    transform: scaleX(0.4);
    transition:
      opacity 0.35s ease,
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .service-card:hover .service-glow {
    opacity: 1;
    transform: scaleX(1);
  }

  /* Icon subtle bounce on card hover */
  .service-icon {
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .service-card:hover .service-icon {
    transform: scale(1.08);
  }

  /* Outcome items stagger in when card is revealed */
  [data-reveal].in-view .outcome-item {
    animation: outcome-fade-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: var(--delay);
  }

  @keyframes outcome-fade-in {
    from {
      opacity: 0;
      transform: translateX(-6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
