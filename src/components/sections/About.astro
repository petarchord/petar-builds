---
import PortraitImage from '../../assets/petar-portfolio-image.png';
import { ui } from '../../i18n/ui';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const tr = ui[lang];

const valueIcons = [
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>`,
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`,
];
const values = tr.about.values.map((v, i) => ({ ...v, icon: valueIcons[i] }));
---

<section id="about" class="px-6 py-32 border-t border-white/[0.06]">
  <div class="max-w-6xl mx-auto">

    <!-- Header -->
    <div data-reveal class="mb-12">
      <p class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase mb-4">{tr.about.eyebrow}</p>
      <h2 class="text-3xl md:text-[2.5rem] font-bold text-white tracking-tight leading-tight">
        {tr.about.heading}
      </h2>
    </div>

    <!-- Portrait + stats: mobile only (hidden on desktop where Hero shows it) -->
    <div class="block lg:hidden mb-12">
      <div class="relative mx-auto" style="width:320px; height:310px;">

        <!-- Portrait circle -->
        <figure
          class="absolute rounded-full overflow-hidden bg-[#101013] border border-white/[0.06]"
          style="width:180px; height:180px; left:70px; top:65px;"
        >
          <img
            src={PortraitImage.src}
            alt="Petar Jovanovic"
            class="w-full h-full object-cover object-top grayscale-[0.8]"
          />
        </figure>

        <!-- Top-left stat -->
        <div class="stat-card absolute" style="width:110px; left:0; top:28px; animation-delay:300ms;">
          <p class="text-white font-bold text-xl tracking-tight leading-none mb-1">7+</p>
          <p class="text-[#555] text-xs leading-snug">{tr.stats.years}</p>
        </div>

        <!-- Top-right stat -->
        <div class="stat-card absolute" style="width:110px; right:0; top:50px; animation-delay:500ms;">
          <p class="text-white font-bold text-xl tracking-tight leading-none mb-1">3</p>
          <p class="text-[#555] text-xs leading-snug">{tr.stats.startups}</p>
        </div>

        <!-- Bottom-left stat -->
        <div class="stat-card absolute" style="width:110px; left:0; bottom:38px; animation-delay:700ms;">
          <p class="text-white font-bold text-xl tracking-tight leading-none mb-1">10+</p>
          <p class="text-[#555] text-xs leading-snug">{tr.stats.projects}</p>
        </div>

        <!-- Bottom-right stat -->
        <div class="stat-card absolute" style="width:110px; right:0; bottom:18px; animation-delay:900ms;">
          <p class="text-white font-bold text-xl tracking-tight leading-none mb-1">100K+</p>
          <p class="text-[#555] text-xs leading-snug">{tr.stats.users}</p>
        </div>

      </div>
    </div>

    <!-- Bio + Values: side-by-side on desktop, stacked on mobile -->
    <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-start">

      <!-- Bio -->
      <div
        data-reveal
        style="transition-delay:80ms"
        class="flex-1 space-y-5 text-[#777] text-base leading-relaxed"
      >
        {tr.about.bio.map((paragraph) => (
          <p set:html={paragraph} />
        ))}
      </div>

      <!-- Values -->
      <div class="lg:w-80 xl:w-96 shrink-0">
        <div data-reveal style="transition-delay:160ms" class="mb-6">
          <p class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase">{tr.about.valuesEyebrow}</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-4">
          {values.map(({ icon, label, body }, i) => (
            <div
              data-reveal
              style={`transition-delay:${160 + i * 70}ms`}
              class="value-card group relative border border-white/[0.06] rounded-xl p-6 hover:border-white/[0.12] hover:bg-white/[0.02] transition-all duration-300"
            >
              <span class="value-glow" aria-hidden="true" />
              <div class="flex items-center gap-3 mb-3">
                <span
                  class="flex items-center justify-center w-8 h-8 rounded-lg bg-white/[0.04] border border-white/[0.06] text-[#818cf8] group-hover:bg-[#818cf8]/10 group-hover:border-[#818cf8]/20 transition-all duration-300 value-icon shrink-0"
                  set:html={icon}
                />
                <h3 class="text-white font-semibold text-sm">{label}</h3>
              </div>
              <p class="text-[#666] text-sm leading-relaxed">{body}</p>
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .value-glow {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 1px;
    border-radius: 0.75rem 0.75rem 0 0;
    background: linear-gradient(90deg, transparent 0%, rgba(129, 140, 248, 0.6) 50%, transparent 100%);
    opacity: 0;
    transform: scaleX(0.4);
    transition:
      opacity 0.35s ease,
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .value-card:hover .value-glow {
    opacity: 1;
    transform: scaleX(1);
  }

  .value-icon {
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .value-card:hover .value-icon {
    transform: scale(1.08);
  }
</style>
