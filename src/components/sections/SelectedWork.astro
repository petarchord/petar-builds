---
const selectedWork = [
  {
    label: 'Fintech · Component Systems',
    company: 'Paayed',
    description:
      'Led the development of a shared React component library and design system, establishing scalable frontend standards that improved UI consistency, accelerated development, and reduced maintenance costs. Delivered core fintech features including secure authentication, 3DS payment flows, Hosted Payment Pages, analytics, CRM, reporting, and accounting modules.',
    outcomes: [
      '90+ legacy components refactored & moved into a shared library',
      'Single source of truth for UI',
      'Faster feature delivery across teams',
      'Compliant with UK acquiring requirements',
    ],
    stack: ['TypeScript', 'React', 'Next.js', 'Tailwind', 'Radix UI', 'Jest', 'Docker', 'AWS'],
    href: '/work#paayed',
  },
  {
    label: 'Enterprise · Micro-Frontends',
    company: 'Symphony',
    description:
      'Delivered a Micro-Frontend platform and shared npm component library adopted by 10+ engineering teams at a Fortune Global 500 company.',
    outcomes: [
      '10+ teams on shared library',
      'Consistent design across all MFEs',
      'Reduced duplication at scale',
    ],
    stack: ['TypeScript', 'React', 'Jest', 'Stryker.js', 'Docker', 'AWS'],
    href: '/work#symphony',
  },
  {
    label: 'Enterprise · Financial Software',
    company: 'Devtech',
    description:
      'Modernized a legacy accounting platform and built complex D3.js big-data visualizations for a Microsoft 365 adoption platform used by thousands of organizations.',
    outcomes: [
      'High-performance financial reporting',
      'Complex data visualizations at scale',
      'Lease accounting workflows delivered',
    ],
    stack: ['TypeScript', 'Next.js', 'D3.js', 'Redux Toolkit', 'PostgreSQL', 'AWS'],
    href: '/work#devtech',
  },
];
---

<section class="px-6 py-32 bg-[#0a0a0d]">
  <div class="max-w-6xl mx-auto">
    <div data-reveal class="flex items-end justify-between mb-14">
      <div>
        <p class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase mb-4">Selected Work</p>
        <h2 class="text-3xl md:text-[2.5rem] font-bold text-white tracking-tight leading-tight">
          What I've built.
        </h2>
      </div>
      <a
        href="/work"
        class="hidden md:flex items-center gap-1.5 text-[#555] hover:text-white text-sm transition-colors duration-200 pb-1"
      >
        All projects <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="space-y-4">
      {selectedWork.map(({ label, company, description, outcomes, stack, href }, i) => (
        <a
          href={href}
          data-reveal
          style={`transition-delay:${i * 80}ms`}
          class="group block border border-white/[0.06] rounded-xl p-7 lg:p-8 hover:border-white/[0.12] hover:bg-white/[0.02] transition-all duration-300"
        >
          <div class="flex flex-col lg:flex-row lg:items-start gap-8">
            <!-- Left: info -->
            <div class="flex-1 min-w-0">
              <p class="text-[#444] text-xs font-mono mb-3">{label}</p>
              <h3 class="text-white font-semibold text-xl mb-3 group-hover:text-[#818cf8] transition-colors duration-200">
                {company}
              </h3>
              <p class="text-[#666] text-sm leading-relaxed mb-6">{description}</p>
              <div class="flex flex-wrap gap-2">
                {stack.map((t) => (
                  <span class="text-[11px] text-[#555] border border-white/[0.06] px-2.5 py-1 rounded-md font-mono">
                    {t}
                  </span>
                ))}
              </div>
            </div>

            <!-- Right: outcomes -->
            <ul class="shrink-0 space-y-2 lg:text-right">
              {outcomes.map((o) => (
                <li class="flex lg:justify-end items-start gap-2 text-sm text-[#666]">
                  <span class="text-[#818cf8] text-xs mt-1 lg:hidden">↗</span>
                  <span>{o}</span>
                  <span class="text-[#818cf8] text-xs mt-1 hidden lg:inline">↗</span>
                </li>
              ))}
            </ul>
          </div>
        </a>
      ))}
    </div>

    <!-- Mobile "all projects" link -->
    <div data-reveal class="mt-6 md:hidden">
      <a href="/work" class="text-sm text-[#555] hover:text-white transition-colors duration-200">
        View all projects →
      </a>
    </div>
  </div>
</section>
