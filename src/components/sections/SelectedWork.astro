---
import ProjectCard from '../work/ProjectCard.astro';
import { projects } from '../../data/projects';
import { ui } from '../../i18n/ui';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const tr = ui[lang];

const [featured, ...others] = projects;
const shown = others.slice(0, 4);

const copy = {
  en: {
    subtitle: 'Products I helped design, build and ship — for fintech startups, enterprise teams and Fortune Global 500 companies.',
    all: `See all ${projects.length} case studies`,
    similar: 'Have a similar product in mind?',
    book: 'Book a free call',
  },
  sr: {
    subtitle: 'Proizvodi koje sam pomogao da se osmisle, izgrade i isporuče — za fintech startape, enterprise timove i Fortune Global 500 kompanije.',
    all: `Pogledajte svih ${projects.length} studija slučaja`,
    similar: 'Imate sličan proizvod na umu?',
    book: 'Zakažite besplatan poziv',
  },
} as const;
const c = copy[lang];
---

<section id="work" class="px-6 py-32 bg-[#0a0a0d]">
  <div class="max-w-6xl mx-auto">
    <div data-reveal class="mb-14 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-[#858585] text-xs font-mono tracking-[0.25em] uppercase mb-4">{tr.work.eyebrow}</p>
        <h2 class="text-3xl md:text-[2.5rem] font-bold text-white tracking-tight leading-tight mb-4">
          {tr.work.heading}
        </h2>
        <p class="text-[#a1a1aa] max-w-2xl text-base leading-relaxed">{c.subtitle}</p>
      </div>
      <a href="/work/" class="hidden md:inline-flex shrink-0 items-center gap-2 whitespace-nowrap text-sm text-[#a1a1aa] hover:text-white transition-colors duration-200">
        {c.all} <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      <ProjectCard project={featured} lang={lang} featured />
      {shown.map((project, i) => (
        <ProjectCard project={project} lang={lang} delay={(i % 2) * 80} />
      ))}
    </div>

    <div data-reveal class="mt-10 flex flex-col items-start gap-4 rounded-2xl border border-white/[0.07] bg-[#0c0c11] p-6 sm:flex-row sm:items-center sm:justify-between md:p-8">
      <p class="text-white text-lg font-semibold tracking-tight">{c.similar}</p>
      <div class="flex flex-wrap gap-3">
        <a href="/work/" class="rounded-lg border border-white/10 px-5 py-2.5 text-sm font-medium text-white hover:border-white/20 hover:bg-white/[0.04] transition-colors duration-200">
          {c.all}
        </a>
        <a href="https://calendly.com/petarbuilds-tech/30min" target="_blank" rel="noopener noreferrer" class="rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-[#09090b] hover:bg-[#e8e8e8] transition-colors duration-200">
          {c.book}
        </a>
      </div>
    </div>
  </div>
</section>
