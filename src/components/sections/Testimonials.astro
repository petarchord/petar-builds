---
import { Image } from 'astro:assets';
import type { Lang } from '../../i18n/ui';
import { testimonials } from '../../data/testimonials';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;

const copy = {
  en: { eyebrow: 'Testimonials', heading: 'What people I’ve worked with say' },
  sr: { eyebrow: 'Preporuke', heading: 'Šta kažu ljudi sa kojima sam radio' },
} as const;

const c = copy[lang];
const initials = (name: string) => name.split(' ').map((p) => p[0]).join('').slice(0, 2);
const [featured, ...rest] = testimonials;
---

<section id="testimonials" class="px-6 py-32">
  <div class="max-w-6xl mx-auto">
    <div data-reveal class="mb-14">
      <p class="text-[#858585] text-xs font-mono tracking-[0.25em] uppercase mb-4">{c.eyebrow}</p>
      <h2 class="text-3xl md:text-[2.5rem] font-bold text-white tracking-tight leading-tight">{c.heading}</h2>
    </div>

    <div data-reveal class="mb-4">
    <figure class="testimonial-card relative overflow-hidden rounded-2xl border border-white/[0.07] bg-[#0c0c11] p-8 md:p-12">
      <span aria-hidden="true" class="quote-mark absolute -top-6 right-8 text-[10rem] leading-none font-serif select-none">“</span>
      <blockquote class="relative text-white/90 text-lg md:text-2xl leading-relaxed tracking-tight max-w-4xl mb-10">
        {featured.quote[lang]}
      </blockquote>
      <figcaption class="relative flex items-center gap-4">
        {featured.avatar ? (
          <Image src={featured.avatar} alt={featured.name} width={96} height={96} class="h-12 w-12 rounded-full object-cover ring-1 ring-white/10" loading="lazy" />
        ) : (
          <span aria-hidden="true" class="avatar h-12 w-12 text-sm">{initials(featured.name)}</span>
        )}
        <div>
          <p class="text-white font-semibold text-sm">{featured.name}</p>
          <p class="text-[#8e8e8e] text-xs font-mono">{featured.role[lang]} · <span class="text-[#818cf8]">{featured.company}</span></p>
        </div>
      </figcaption>
    </figure>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      {rest.map((t, i) => (
        <div data-reveal style={`transition-delay:${(i % 2) * 80}ms`} class="flex min-w-0">
        <figure class="testimonial-card relative flex min-w-0 flex-1 flex-col rounded-2xl border border-white/[0.07] bg-[#0c0c11] p-6 sm:p-7 md:p-8">
          <span aria-hidden="true" class="text-[#818cf8]/60 text-3xl leading-none font-serif mb-4">“</span>
          <blockquote class="text-[#a1a1aa] text-sm md:text-[15px] leading-relaxed mb-8">{t.quote[lang]}</blockquote>
          <figcaption class="mt-auto flex items-center gap-3.5 pt-5 border-t border-white/[0.06]">
            {t.avatar ? (
              <Image src={t.avatar} alt={t.name} width={80} height={80} class="h-10 w-10 rounded-full object-cover ring-1 ring-white/10" loading="lazy" />
            ) : (
              <span aria-hidden="true" class="avatar h-10 w-10 text-xs">{initials(t.name)}</span>
            )}
            <div class="min-w-0">
              <p class="text-white font-semibold text-sm">{t.name}</p>
              <p class="text-[#8e8e8e] text-xs font-mono">{t.role[lang]} · <span class="text-[#818cf8]">{t.company}</span></p>
            </div>
          </figcaption>
        </figure>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .avatar {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #c7d2fe;
    background:
      radial-gradient(circle at 30% 25%, rgba(129, 140, 248, 0.45) 0%, transparent 60%),
      linear-gradient(145deg, #1e1b4b 0%, #111118 100%);
    box-shadow: inset 0 0 0 1px rgba(129, 140, 248, 0.3);
  }

  .quote-mark {
    color: rgba(129, 140, 248, 0.08);
  }

  .testimonial-card {
    transition:
      transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 240ms ease,
      background-color 240ms ease;
  }

  .testimonial-card:hover {
    transform: translateY(-4px);
    border-color: rgba(129, 140, 248, 0.35);
    background-color: #0f0f15;
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonial-card {
      transition: none;
    }

    .testimonial-card:hover {
      transform: none;
    }
  }
</style>
