---
import { getCollection } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const ideas = [
  {
    title: 'Building a React Component Library from Scratch',
    description: 'Design tokens, Storybook, Chromatic, and the decisions that matter.',
    tag: 'Architecture',
  },
  {
    title: 'How We Standardized 90+ Components',
    description: 'A real-world story of migrating a fragmented frontend to a single design system.',
    tag: 'Design Systems',
  },
  {
    title: "Why AI Won't Replace Senior Engineers",
    description: 'AI is a force multiplier—but judgment, taste, and context still win.',
    tag: 'Opinion',
  },
  {
    title: "Virtualization Isn't Magic",
    description: 'What windowing really does, and when you actually need it.',
    tag: 'Performance',
  },
];
---

<section id="writing" class="px-6 py-32 border-t border-white/[0.06] bg-[#0a0a0d]">
  <div class="max-w-6xl mx-auto">
    <div data-reveal class="mb-14">
      <p class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase mb-4">Writing</p>
      <h2 class="text-3xl md:text-[2.5rem] font-bold text-white tracking-tight leading-tight">
        Thinking out loud.
      </h2>
      <p class="text-[#666] text-base leading-relaxed mt-4 max-w-lg">
        Articles on frontend engineering, design systems, and building software
        that's maintainable at scale.
      </p>
    </div>

    <!-- In-progress articles -->
    <div data-reveal style="transition-delay:80ms" class="mb-12">
      <p class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase mb-6">In progress</p>
      <div class="grid sm:grid-cols-2 gap-4">
        {ideas.map(({ title, description, tag }, i) => (
          <div
            data-reveal
            style={`transition-delay:${80 + i * 70}ms`}
            class="border border-white/[0.06] rounded-xl p-6 hover:border-white/[0.10] hover:bg-white/[0.02] transition-all duration-300 cursor-default"
          >
            <span class="text-[10px] text-[#818cf8] font-mono tracking-widest uppercase border border-[#818cf8]/25 px-2 py-0.5 rounded-full">
              {tag}
            </span>
            <h3 class="text-white font-semibold text-base mt-4 mb-2 leading-snug">{title}</h3>
            <p class="text-[#666] text-sm leading-relaxed">{description}</p>
            <p class="text-[#3f3f46] text-xs font-mono mt-4">Coming soon</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Published posts -->
    {posts.length > 0 && (
      <div data-reveal style="transition-delay:160ms">
        <p class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase mb-6">Published</p>
        <div class="divide-y divide-white/[0.06]">
          {posts.map((post, i) => (
            <a
              href={`/blog/${post.id}/`}
              data-reveal
              style={`transition-delay:${160 + i * 60}ms`}
              class="group flex flex-col sm:flex-row sm:items-center justify-between gap-3 py-5 hover:text-white transition-colors duration-200"
            >
              <h3 class="text-[#aaa] group-hover:text-white font-medium text-base transition-colors duration-200">
                {post.data.title}
              </h3>
              <span class="text-[#444] text-xs font-mono shrink-0">
                <FormattedDate date={post.data.pubDate} />
              </span>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
