---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from '../FormattedDate.astro';
import { ui } from '../../i18n/ui';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const tr = ui[lang];

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const withMeta = posts.map((post) => ({
  ...post,
  readingTime: Math.max(1, Math.ceil((post.body?.split(/\s+/).length ?? 0) / 200)),
}));
---

<section id="writing" class="px-6 py-32 border-t border-white/[0.06] bg-[#0a0a0d]">
  <div class="max-w-6xl mx-auto">
    <div data-reveal class="mb-14">
      <p class="text-[#666] text-xs font-mono tracking-[0.25em] uppercase mb-4">{tr.writing.eyebrow}</p>
      <h2 class="text-3xl md:text-[2.5rem] font-bold text-white tracking-tight leading-tight">
        {tr.writing.heading}
      </h2>
      <p class="text-[#666] text-base leading-relaxed mt-4 max-w-lg">
        {tr.writing.subheading}
      </p>
    </div>

    {withMeta.length > 0 && (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {withMeta.map((post, i) => (
          <a
            href={`/blog/${post.id}/`}
            data-reveal
            style={`transition-delay:${i * 80}ms`}
            class="group flex flex-col border border-white/[0.06] rounded-xl overflow-hidden hover:border-white/[0.12] hover:bg-white/[0.02] transition-all duration-300"
          >
            <!-- Card image -->
            {post.data.heroImage ? (
              <div class="aspect-[16/9] overflow-hidden bg-[#101013]">
                <Image
                  src={post.data.heroImage}
                  alt={post.data.title}
                  widths={[400, 800]}
                  sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
                  class="w-full h-full object-cover group-hover:opacity-90 group-hover:scale-[1.02] transition-all duration-500"
                />
              </div>
            ) : (
              <div class="aspect-[16/9] bg-gradient-to-br from-[#818cf8]/10 to-[#6366f1]/5 border-b border-white/[0.06]" />
            )}

            <!-- Card body -->
            <div class="flex flex-col flex-1 p-6">
              <!-- Tags -->
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mb-3">
                  {post.data.tags.map((tag: string) => (
                    <span class="text-[10px] text-[#818cf8] font-mono tracking-widest uppercase border border-[#818cf8]/25 px-2 py-0.5 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              )}

              <!-- Title -->
              <h3 class="text-white font-semibold text-base leading-snug mb-2 group-hover:text-[#818cf8] transition-colors duration-200">
                {post.data.title}
              </h3>

              <!-- Description -->
              <p class="text-[#777] text-sm leading-relaxed flex-1 mb-4">
                {post.data.description}
              </p>

              <!-- Meta row -->
              <div class="flex items-center justify-between text-[#3f3f46] text-xs font-mono mt-auto pt-4 border-t border-white/[0.05]">
                <FormattedDate date={post.data.pubDate} />
                <span>{post.readingTime} {tr.writing.minRead}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</section>

