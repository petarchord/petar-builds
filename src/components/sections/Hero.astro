---

---

<section class="min-h-[100svh] flex items-center px-6 pt-28 pb-20">
  <div class="max-w-6xl mx-auto w-full grid lg:grid-cols-[1fr_360px] gap-16 lg:gap-24 items-center">
    <!-- Text -->
    <div>
      <p
        data-reveal
        class="text-[#555] text-xs font-mono tracking-[0.25em] uppercase mb-8"
      >
        Sr. Web Developer | Saas Specialist | AI Enthusiast
      </p>
      <h1
        data-reveal
        style="transition-delay:80ms"
        class="text-[clamp(2.4rem,5.5vw,4rem)] font-bold text-white leading-[1.08] tracking-[-0.025em] mb-7"
      >
        Building scalable software that grows with your business.
      </h1>
      <p
        data-reveal
        style="transition-delay:160ms"
        class="text-[#888] text-lg leading-relaxed max-w-[520px] mb-10"
      >
        I've spent the last 7+ years building products for industry leaders,
        including platforms for Fortune Global 500 companies spanning fintech,
        ed-tech, social networking, and e-commerce.
      </p>
      <div data-reveal style="transition-delay:240ms" class="flex flex-wrap gap-3">
        <a
          href="/work"
          class="bg-white text-[#09090b] text-sm font-semibold px-6 py-3 rounded-lg hover:bg-[#e8e8e8] transition-colors duration-200"
        >
          View my work
        </a>
        <a
          href="/contact"
          class="border border-white/10 text-white text-sm font-medium px-6 py-3 rounded-lg hover:border-white/20 hover:bg-white/[0.04] transition-colors duration-200"
        >
          Let's talk
        </a>
      </div>
    </div>

    <!-- Portrait -->
    <div data-reveal style="transition-delay:320ms" class="hidden lg:block">
      <figure class="w-[300px] h-[300px] rounded-full aspect-[4/5] overflow-hidden bg-[#101013] border border-white/[0.06]">
        <img
          src="/src/assets/petar-portfolio-image.png"
          alt="Petar Jovanovic"
          class="w-full h-full object-cover object-top grayscale-[0.8]"
        />
      </figure>
    </div>
  </div>
</section>
