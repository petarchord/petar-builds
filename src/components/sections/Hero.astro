---
import { Image } from 'astro:assets';
import PortraitImage from '../../assets/petar-portfolio-image.webp';
import WorkedWith from './WorkedWith.astro';
import { ui } from '../../i18n/ui';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const tr = ui[lang];
const prefix = lang === 'sr' ? '/sr' : '';
---

<section id="hero" class="min-h-[100svh] flex items-center px-6 pt-28 pb-20 overflow-x-hidden">
  <div class="max-w-6xl mx-auto w-full grid lg:grid-cols-[1fr_440px] gap-16 lg:gap-20 items-center">

    <!-- ─── Left column: text + CTAs + worked-with ─── -->
    <div class="min-w-0 overflow-hidden">
      <p
        data-reveal
        class="text-[#777] text-xs font-mono tracking-[0.25em] uppercase mb-8"
      >
        {tr.hero.eyebrow}
      </p>
      <h1
        data-reveal
        style="transition-delay:80ms"
        class="text-[clamp(2.4rem,5.5vw,4rem)] font-bold text-white leading-[1.08] tracking-[-0.025em] mb-7"
        set:html={tr.hero.headingHtml}
      />
      <p
        data-reveal
        style="transition-delay:160ms"
        class="text-[#888] text-lg leading-relaxed max-w-[520px] mb-10"
      >
        {tr.hero.body}
      </p>

      <!-- CTAs -->
      <div data-reveal style="transition-delay:240ms" class="flex flex-wrap gap-3 mb-12">
        <a
          href={`${prefix}/#work`}
          class="bg-white text-[#09090b] text-sm font-semibold px-6 py-3 rounded-lg hover:bg-[#e8e8e8] transition-colors duration-200"
        >
          {tr.hero.ctaWork}
        </a>
        <a
          href={`${prefix}/#contact`}
          class="border border-white/10 text-white text-sm font-medium px-6 py-3 rounded-lg hover:border-white/20 hover:bg-white/[0.04] transition-colors duration-200"
        >
          {tr.hero.ctaTalk}
        </a>
      </div>

      <!-- Worked with -->
      <div data-reveal style="transition-delay:340ms">
        <WorkedWith label={tr.hero.workedWithLabel} />
      </div>
    </div>

    <!-- ─── Right column: portrait + floating stat cards ─── -->
    <div class="hidden lg:flex justify-center items-center">
      <!--
        Container sized to comfortably hold the 240px circle + the cards
        that float beyond its edges. Cards use absolute positioning.
      -->
      <div class="relative" style="width:420px; height:400px;">

        <!-- Portrait circle -->
        <figure
          class="absolute rounded-full overflow-hidden bg-[#101013] border border-white/[0.06]"
          style="width:240px; height:240px; left:90px; top:80px;"
        >
          <Image
            src={PortraitImage}
            alt="Petar Jovanovic"
            width={480}
            height={480}
            loading="eager"
            fetchpriority="high"
            class="w-full h-full object-cover object-top grayscale-[0.8]"
          />
        </figure>

        <!-- ── Stat cards – each pops in with a staggered delay ── -->

        <!-- Top-left: 7+ years -->
        <div class="stat-card absolute" style="width:130px; left:0; top:36px; animation-delay:500ms;">
          <p class="text-white font-bold text-2xl tracking-tight leading-none mb-1.5">7+</p>
          <p class="text-[#777] text-xs leading-snug">{tr.stats.years}</p>
        </div>

        <!-- Top-right: startups -->
        <div class="stat-card absolute" style="width:130px; right:0; top:62px; animation-delay:700ms;">
          <p class="text-white font-bold text-2xl tracking-tight leading-none mb-1.5">3</p>
          <p class="text-[#777] text-xs leading-snug">{tr.stats.startups}</p>
        </div>

        <!-- Bottom-left: 10+ projects -->
        <div class="stat-card absolute" style="width:130px; left:0; bottom:52px; animation-delay:900ms;">
          <p class="text-white font-bold text-2xl tracking-tight leading-none mb-1.5">10+</p>
          <p class="text-[#777] text-xs leading-snug">{tr.stats.projects}</p>
        </div>

        <!-- Bottom-right: 100K+ users -->
        <div class="stat-card absolute" style="width:130px; right:0; bottom:28px; animation-delay:1100ms;">
          <p class="text-white font-bold text-2xl tracking-tight leading-none mb-1.5">100K+</p>
          <p class="text-[#777] text-xs leading-snug">{tr.stats.users}</p>
        </div>

      </div>
    </div>

  </div>
</section>
