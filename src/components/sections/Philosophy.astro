---
const principles = [
  {
    title: 'Think in systems',
    body: 'Every feature matters, but the architecture behind it determines how well the product grows. I build with the bigger picture in mind, so today\'s decisions don\'t become tomorrow\'s technical debt.',
  },
  {
    title: 'Ship with purpose',
    body: 'Every technical decision should solve real problems and create value for both users and the business. The best engineering moves the product forward, not just the codebase.',
  },
  {
    title: 'Simplicity scales',
    body: 'The best solutions remove unnecessary complexity, making products easier to build, maintain, and evolve. Simplicity isn\'t cutting corners, it\'s making the right trade-offs.',
  },
  {
    title: 'AI accelerates engineers',
    body: 'AI helps me move faster, explore ideas, and automate repetitive work. Engineering judgment, product thinking, and experience are what turn that speed into great software.',
  },
];
---

<section class="px-6 py-32">
  <div class="max-w-6xl mx-auto">
    <div data-reveal class="mb-14">
      <p class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase mb-4">How I build software</p>
      <h2 class="text-3xl md:text-[2.5rem] font-bold text-white tracking-tight leading-tight">
        Engineering principles
      </h2>
    </div>

    <!-- Divider-grid: gap-px + parent bg colour acts as the divider line -->
    <div class="grid md:grid-cols-2 gap-px bg-white/[0.06]">
      {principles.map(({ title, body }, i) => (
        <div
          data-reveal
          style={`transition-delay:${i * 80}ms`}
          class="bg-[#09090b] p-8 lg:p-10 hover:bg-[#0c0c0f] transition-colors duration-300"
        >
          <h3 class="text-white font-semibold text-lg mb-3">{title}</h3>
          <p class="text-[#666] text-sm leading-relaxed">{body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
