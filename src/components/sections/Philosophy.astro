---
import { ui } from '../../i18n/ui';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const tr = ui[lang];
const prefix = lang === 'sr' ? '/sr' : '';

const stepIcons = [
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/><path d="M11 8v3l2 2"/></svg>`,
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 1 7 7c0 2.97-1.85 5.52-4.5 6.57V17a1 1 0 0 1-1 1h-3a1 1 0 0 1-1-1v-1.43C6.85 14.52 5 11.97 5 9a7 7 0 0 1 7-7z"/></svg>`,
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
];
const numbers = ['01', '02', '03', '04'];
const steps = tr.philosophy.steps.map((s, i) => ({ ...s, icon: stepIcons[i], number: numbers[i] }));
---

<section class="px-6 py-32 bg-[#0a0a0d]">
  <div class="max-w-6xl mx-auto">

    <div data-reveal class="mb-16">
      <p class="text-[#858585] text-xs font-mono tracking-[0.25em] uppercase mb-4">{tr.philosophy.eyebrow}</p>
      <h2 class="text-3xl md:text-[2.5rem] font-bold text-white tracking-tight leading-tight">
        {tr.philosophy.heading}
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      {steps.map(({ number, icon, title, body }, i) => (
        <div
          data-reveal
          style={`transition-delay:${i * 100}ms`}
          class="process-card group relative border border-white/[0.06] rounded-xl p-8 hover:border-white/[0.12] hover:bg-white/[0.02] transition-all duration-300 overflow-hidden"
        >
          <span class="process-glow" aria-hidden="true" />

          <span class="absolute top-5 right-6 text-[4rem] font-bold text-white/[0.03] leading-none select-none pointer-events-none group-hover:text-white/[0.05] transition-colors duration-500">
            {number}
          </span>

          <span
            class="process-icon flex items-center justify-center w-11 h-11 rounded-xl bg-white/[0.04] border border-white/[0.06] text-[#818cf8] mb-6 group-hover:bg-[#818cf8]/10 group-hover:border-[#818cf8]/20 transition-all duration-300"
            set:html={icon}
          />

          <p class="text-[#858585] text-xs font-mono mb-2">{tr.philosophy.stepLabel} {number}</p>

          <h3 class="text-white font-semibold text-lg mb-3 group-hover:text-[#818cf8] transition-colors duration-200">
            {title}
          </h3>

          <p class="text-[#858585] text-sm leading-relaxed">{body}</p>
        </div>
      ))}
    </div>

    <!-- CTAs -->
    <div data-reveal class="mt-14 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="https://calendly.com/petarbuilds-tech/30min"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2.5 bg-[#818cf8] text-white text-sm font-semibold px-6 py-3.5 rounded-lg hover:bg-[#6366f1] transition-colors duration-200 w-full sm:w-auto"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        {tr.philosophy.ctaBook}
      </a>
      <a
        href={`${prefix}/#work`}
        class="inline-flex items-center justify-center gap-2 border border-white/10 text-white text-sm font-medium px-6 py-3.5 rounded-lg hover:border-white/20 hover:bg-white/[0.04] transition-colors duration-200 w-full sm:w-auto"
      >
        {tr.philosophy.ctaWork}
      </a>
    </div>

  </div>
</section>

<style>
  .process-glow {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 1px;
    border-radius: 0.75rem 0.75rem 0 0;
    background: linear-gradient(90deg, transparent 0%, rgba(129, 140, 248, 0.65) 50%, transparent 100%);
    opacity: 0;
    transform: scaleX(0.4);
    transition:
      opacity 0.35s ease,
      transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .process-card:hover .process-glow {
    opacity: 1;
    transform: scaleX(1);
  }

  .process-icon {
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .process-card:hover .process-icon {
    transform: scale(1.08);
  }
</style>

