---
import { Image } from 'astro:assets';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import ProjectVisual from '../../components/work/ProjectVisual.astro';
import TechIcon from '../../components/TechIcon.astro';
import { projects, type Project } from '../../data/projects';
import { getTestimonial, type Testimonial } from '../../data/testimonials';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const testimonials = (project.testimonialIds ?? [])
  .map(getTestimonial)
  .filter((t): t is Testimonial => Boolean(t));

const initials = (name: string) => name.split(' ').map((p) => p[0]).join('').slice(0, 2);
const CALENDLY_URL = 'https://calendly.com/petarbuilds-tech/30min';

const meta = [
  { label: 'Client', value: project.client },
  { label: 'Role', value: project.role },
  { label: 'Year', value: project.year },
];
---

<PortfolioLayout
  title={`${project.title.en} — Case Study | Petar Jovanovic`}
  description={project.summary.en}
>
  <article>
    <!-- Header -->
    <header class="px-6 pt-32 pb-12">
      <div class="max-w-5xl mx-auto">
        <a href="/work/" class="mb-10 inline-flex items-center gap-2 text-sm text-[#8e8e8e] hover:text-white transition-colors duration-200">
          <span aria-hidden="true">←</span> All case studies
        </a>
        <p data-reveal class="mb-4 text-xs font-mono uppercase tracking-[0.2em] text-[#818cf8]">{project.category.en}</p>
        <h1 data-reveal style="transition-delay:60ms" class="mb-6 max-w-4xl text-4xl md:text-5xl font-bold tracking-tight leading-[1.1] text-white">
          {project.title.en}
        </h1>
        <p data-reveal style="transition-delay:120ms" class="max-w-3xl text-lg leading-relaxed text-[#a1a1aa]">{project.summary.en}</p>
        {project.liveUrl && (
          <a
            data-reveal
            style="transition-delay:150ms"
            href={project.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center gap-2 rounded-full border border-white/[0.12] px-4 py-2 text-sm font-medium text-[#d4d4d8] hover:border-[#818cf8]/60 hover:text-white transition-colors duration-200"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-[#818cf8]"></span>
            Visit live site
            <span aria-hidden="true">↗</span>
          </a>
        )}

        <dl data-reveal style="transition-delay:180ms" class="mt-10 grid gap-6 border-t border-white/[0.06] pt-8 sm:grid-cols-2 lg:grid-cols-4">
          {meta.map(({ label, value }) => (
            <div>
              <dt class="mb-1.5 text-[11px] font-mono uppercase tracking-[0.2em] text-[#80808a]">{label}</dt>
              <dd class="text-sm text-[#d4d4d8]">{value}</dd>
            </div>
          ))}
          <div>
            <dt class="mb-1.5 text-[11px] font-mono uppercase tracking-[0.2em] text-[#80808a]">Stack</dt>
            <dd class="flex flex-wrap gap-1.5">
              {project.stack.map((t) => (
                <span class="inline-flex items-center gap-1.5 rounded-md border border-white/[0.06] px-2 py-0.5 font-mono text-[10px] text-[#8e8e8e]">
                  <TechIcon name={t} size={10} />{t}
                </span>
              ))}
            </dd>
          </div>
        </dl>
      </div>
    </header>

    <!-- Visual -->
    <div data-reveal class="px-6">
      <div class="max-w-5xl mx-auto">
        <ProjectVisual project={project} eager large />
      </div>
    </div>

    <!-- Key results -->
    <section class="px-6 pt-16">
      <div class="max-w-5xl mx-auto grid gap-4 sm:grid-cols-3">
        {project.metrics.map((m, i) => (
          <div data-reveal style={`transition-delay:${i * 80}ms`} class="rounded-2xl border border-white/[0.07] bg-[#0c0c11] p-6">
            <p class="mb-2 text-3xl font-bold tracking-tight text-white">{m.value}</p>
            <p class="text-sm leading-snug text-[#8e8e8e]">{m.label}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Problem / Solution / Results -->
    <div class="px-6 py-20">
      <div class="max-w-5xl mx-auto divide-y divide-white/[0.06]">
        <section data-reveal class="grid gap-6 py-12 md:grid-cols-[200px_1fr] md:gap-12">
          <h2 class="text-xs font-mono uppercase tracking-[0.25em] text-[#818cf8]"><span class="text-[#80808a]">01 /</span> Problem</h2>
          <div class="space-y-4 text-lg leading-relaxed text-[#d4d4d8]">
            {project.problem.map((p) => <p>{p}</p>)}
          </div>
        </section>

        <section data-reveal class="grid gap-6 py-12 md:grid-cols-[200px_1fr] md:gap-12">
          <h2 class="text-xs font-mono uppercase tracking-[0.25em] text-[#818cf8]"><span class="text-[#80808a]">02 /</span> Solution</h2>
          <div>
            <p class="mb-6 text-lg leading-relaxed text-[#d4d4d8]">{project.solution.intro}</p>
            <ul class="space-y-3">
              {project.solution.points.map((point) => (
                <li class="flex gap-3 text-base leading-relaxed text-[#a1a1aa]">
                  <span class="mt-1 shrink-0 text-[#818cf8]">›</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <section data-reveal class="grid gap-6 py-12 md:grid-cols-[200px_1fr] md:gap-12">
          <h2 class="text-xs font-mono uppercase tracking-[0.25em] text-[#818cf8]"><span class="text-[#80808a]">03 /</span> Results</h2>
          <ul class="grid gap-3 sm:grid-cols-2">
            {project.results.map((r) => (
              <li class="flex gap-3 rounded-xl border border-white/[0.06] bg-white/[0.02] px-4 py-3.5 text-sm leading-relaxed text-[#d4d4d8]">
                <span class="mt-0.5 shrink-0 text-[#818cf8]">✓</span>
                <span>{r}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>

    <!-- Testimonials -->
    {testimonials.length > 0 && (
      <section class="px-6 pb-20">
        <div class={`max-w-5xl mx-auto grid gap-4 ${testimonials.length > 1 ? 'md:grid-cols-2' : ''}`}>
          {testimonials.map((t) => (
            <figure data-reveal class="flex flex-col rounded-2xl border border-white/[0.07] bg-[#0c0c11] p-7 md:p-8">
              <span aria-hidden="true" class="mb-4 font-serif text-4xl leading-none text-[#818cf8]/60">“</span>
              <blockquote class="mb-8 text-base leading-relaxed text-white/85 md:text-lg">{t.quote.en}</blockquote>
              <figcaption class="mt-auto flex items-center gap-3.5 border-t border-white/[0.06] pt-5">
                {t.avatar ? (
                  <Image src={t.avatar} alt={t.name} width={96} height={96} class="h-11 w-11 rounded-full object-cover ring-1 ring-white/10" loading="lazy" />
                ) : (
                  <span aria-hidden="true" class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-[#1e1b4b] text-xs font-semibold text-[#c7d2fe]">{initials(t.name)}</span>
                )}
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-white">{t.name}</p>
                  <p class="text-xs font-mono text-[#8e8e8e]">{t.role.en} · <span class="text-[#818cf8]">{t.company}</span></p>
                </div>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class="px-6">
      <div data-reveal class="cta-panel relative mx-auto max-w-5xl overflow-hidden rounded-3xl border border-white/[0.08] px-6 py-14 text-center md:px-12 md:py-16">
        <p class="mb-4 text-xs font-mono uppercase tracking-[0.25em] text-[#818cf8]">Let’s work together</p>
        <h2 class="mx-auto mb-5 max-w-2xl text-3xl md:text-4xl font-bold tracking-tight leading-tight text-white">
          Facing a similar challenge?
        </h2>
        <p class="mx-auto mb-8 max-w-xl text-base leading-relaxed text-[#a1a1aa]">
          Whether it’s an MVP, a design system or a legacy product that’s getting hard to maintain — let’s talk about
          what you’re building and how I can help ship it.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href={CALENDLY_URL} target="_blank" rel="noopener noreferrer" class="rounded-lg bg-white px-6 py-3 text-sm font-semibold text-[#09090b] hover:bg-[#e8e8e8] transition-colors duration-200">
            Book a free call
          </a>
          <a href="mailto:petarbuilds.tech@gmail.com" class="rounded-lg border border-white/10 px-6 py-3 text-sm font-medium text-white hover:border-white/20 hover:bg-white/[0.04] transition-colors duration-200">
            petarbuilds.tech@gmail.com
          </a>
        </div>
      </div>
    </section>

    <!-- Next case study -->
    <nav aria-label="Next case study" class="px-6 pt-16">
      <a href={`/work/${next.slug}/`} class="group mx-auto flex max-w-5xl items-center justify-between gap-6 rounded-2xl border border-white/[0.07] bg-[#0c0c11] p-6 md:p-8 hover:border-[#818cf8]/35 transition-colors duration-300">
        <div class="min-w-0">
          <p class="mb-2 text-[11px] font-mono uppercase tracking-[0.2em] text-[#80808a]">Next case study</p>
          <p class="text-lg md:text-xl font-semibold tracking-tight text-white group-hover:text-[#c7d2fe] transition-colors duration-300">{next.title.en}</p>
        </div>
        <span aria-hidden="true" class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/[0.15] text-white transition-all duration-300 group-hover:border-[#818cf8] group-hover:bg-[#818cf8] group-hover:text-[#0a0a0d]">→</span>
      </a>
    </nav>
  </article>
</PortfolioLayout>

<style>
  .cta-panel {
    background:
      radial-gradient(ellipse at 50% 0%, rgba(129, 140, 248, 0.22) 0%, transparent 60%),
      #0c0c11;
  }
</style>
