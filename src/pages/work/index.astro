---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import ProjectCard from '../../components/work/ProjectCard.astro';
import { projects } from '../../data/projects';

const [featured, ...others] = projects;
---

<PortfolioLayout
  title="Case Studies — Petar Jovanovic"
  description="Case studies from 7+ years building SaaS, fintech and enterprise products: the problem, the solution and the results."
>
  <!-- Page header -->
  <section class="pt-36 pb-16 px-6">
    <div class="max-w-6xl mx-auto">
      <p data-reveal class="text-[#858585] text-xs font-mono tracking-[0.25em] uppercase mb-5">Case Studies</p>
      <h1
        data-reveal
        style="transition-delay:80ms"
        class="text-4xl md:text-5xl font-bold text-white tracking-tight leading-tight max-w-3xl"
      >
        Products I helped ship<br class="hidden sm:block" /> and the problems they solved
      </h1>
      <p
        data-reveal
        style="transition-delay:160ms"
        class="text-[#a1a1aa] text-lg leading-relaxed mt-6 max-w-2xl"
      >
        From fintech startups to Fortune Global 500 enterprises. Each case study covers the problem,
        how I approached it, and what changed as a result.
      </p>
    </div>
  </section>

  <section class="px-6 pb-24">
    <div class="max-w-6xl mx-auto grid gap-5 md:grid-cols-2">
      <ProjectCard project={featured} featured />
      {others.map((project, i) => (
        <ProjectCard project={project} delay={(i % 2) * 80} />
      ))}
    </div>
  </section>

  <!-- ─── Earlier Work ─────────────────────────────────────── -->
  <section class="px-6 py-24 bg-[#0a0a0d]">
    <div class="max-w-6xl mx-auto">
      <div data-reveal class="mb-12">
        <p class="text-[#858585] text-xs font-mono tracking-[0.25em] uppercase mb-4">Earlier Work</p>
        <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">More projects</h2>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          {
            company: 'Symphony',
            role: 'Frontend Engineer',
            period: '2022–2024',
            projects: [
              {
                name: 'Internal Learning Platform',
                desc: 'Developed and released a knowledge-sharing platform used by hundreds of employees to learn, share knowledge, and collaborate in a structured way. Google APIs for auth & content, Firebase backend.',
              },
            ],
            stack: ['TypeScript', 'React', 'Redux Toolkit', 'Material UI', 'Firebase'],
          },
          {
            company: 'Permanentum',
            role: 'Head of Software & Support',
            period: 'Jan 2020–Oct 2020',
            projects: [
              {
                name: 'Affiliate Marketing Platform',
                desc: 'Delivered the platform from scratch — Ethereum-backed position purchase & subscription mechanism, multi-level referral flows, and complex D3-style visualizations of deep referral hierarchies (thousands of nodes).',
              },
            ],
            stack: ['TypeScript', 'React', 'Node.js', 'MySQL'],
          },
          {
            company: 'Boopro',
            role: 'Software Developer',
            period: 'Jan 2019–Dec 2019',
            projects: [
              {
                name: 'Bridge TV',
                desc: 'Smart TV application for Samsung & LG — built the UI from scratch with full player control features.',
              },
              {
                name: 'Magic Unbox',
                desc: 'Entertainment platform — integrated payment processing, email operations, and real-time promotional & probability logic.',
              },
            ],
            stack: ['TypeScript', 'React', 'Redux', 'Node.js', 'PHP', 'MySQL'],
          },
        ].map(({ company, role, period, projects, stack }, i) => (
          <div
            data-reveal
            style={`transition-delay:${i * 80}ms`}
            class="border border-white/[0.06] rounded-xl p-6 hover:border-white/[0.10] transition-colors duration-300 flex flex-col"
          >
            <div class="flex items-start justify-between gap-2 mb-1">
              <h3 class="text-white font-semibold text-sm">{company}</h3>
              <span class="text-[#80808a] text-xs font-mono shrink-0">{period}</span>
            </div>
            <p class="text-[#858585] text-xs font-mono mb-4">{role}</p>
            <ul class="space-y-3 flex-1">
              {projects.map(p => (
                <li class="text-[#858585] text-xs leading-relaxed">
                  <span class="text-[#818cf8] font-medium">{p.name}</span>
                  <span class="text-[#8e8e8e]"> — </span>
                  {p.desc}
                </li>
              ))}
            </ul>
            <div class="flex flex-wrap gap-1.5 mt-5 pt-4 border-t border-white/[0.05]">
              {stack.map(t => (
                <span class="text-[10px] text-[#858585] font-mono border border-white/[0.05] px-2 py-0.5 rounded">{t}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</PortfolioLayout>
