---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import PortfolioLayout from '../layouts/PortfolioLayout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Suggested future articles
const ideas = [
  {
    title: 'Building a React Component Library from Scratch',
    description: 'Design tokens, Storybook, Chromatic, and the decisions that matter.',
    tag: 'Architecture',
  },
  {
    title: 'How We Standardized 90+ Components',
    description: 'A real-world story of migrating a fragmented frontend to a single design system.',
    tag: 'Design Systems',
  },
  {
    title: 'Why AI Won\'t Replace Senior Engineers',
    description: 'AI is a force multiplier—but judgment, taste, and context still win.',
    tag: 'Opinion',
  },
  {
    title: 'Virtualization Isn\'t Magic',
    description: 'What windowing really does, and when you actually need it.',
    tag: 'Performance',
  },
];
---

<PortfolioLayout
  title="Writing — Petar Jovanovic"
  description="Articles on frontend engineering, component systems, and building software that scales."
>
  <!-- Header -->
  <section class="pt-36 pb-16 px-6 border-b border-white/[0.06]">
    <div class="max-w-6xl mx-auto">
      <p data-reveal class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase mb-5">Writing</p>
      <h1
        data-reveal
        style="transition-delay:80ms"
        class="text-4xl md:text-5xl font-bold text-white tracking-tight leading-tight max-w-xl"
      >
        Thinking out loud.
      </h1>
      <p
        data-reveal
        style="transition-delay:160ms"
        class="text-[#666] text-lg leading-relaxed mt-6 max-w-lg"
      >
        Articles on frontend engineering, design systems, and building software
        that's maintainable at scale.
      </p>
    </div>
  </section>

  <!-- Coming soon articles -->
  <section class="px-6 py-20 border-b border-white/[0.06]">
    <div class="max-w-6xl mx-auto">
      <p data-reveal class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase mb-10">In progress</p>
      <div class="grid sm:grid-cols-2 gap-4">
        {ideas.map(({ title, description, tag }, i) => (
          <div
            data-reveal
            style={`transition-delay:${i * 80}ms`}
            class="border border-white/[0.06] rounded-xl p-6 hover:border-white/[0.10] hover:bg-white/[0.02] transition-all duration-300 cursor-default"
          >
            <span class="text-[10px] text-[#818cf8] font-mono tracking-widest uppercase border border-[#818cf8]/25 px-2 py-0.5 rounded-full">
              {tag}
            </span>
            <h3 class="text-white font-semibold text-base mt-4 mb-2 leading-snug">{title}</h3>
            <p class="text-[#666] text-sm leading-relaxed">{description}</p>
            <p class="text-[#3f3f46] text-xs font-mono mt-4">Coming soon</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Published posts -->
  {posts.length > 0 && (
    <section class="px-6 py-20">
      <div class="max-w-6xl mx-auto">
        <p data-reveal class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase mb-10">Published</p>
        <div class="divide-y divide-white/[0.06]">
          {posts.map((post, i) => (
            <a
              href={`/blog/${post.id}/`}
              data-reveal
              style={`transition-delay:${i * 60}ms`}
              class="group flex flex-col sm:flex-row sm:items-center justify-between gap-3 py-6 hover:text-white transition-colors duration-200"
            >
              <h3 class="text-[#aaa] group-hover:text-white font-medium text-base transition-colors duration-200">
                {post.data.title}
              </h3>
              <span class="text-[#444] text-xs font-mono shrink-0">
                <FormattedDate date={post.data.pubDate} />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</PortfolioLayout>
