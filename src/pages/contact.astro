---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
---

<PortfolioLayout
  title="Contact — Petar Jovanovic"
  description="Get in touch with Petar Jovanovic, Senior Software Engineer."
>
  <section class="min-h-[80svh] flex items-center px-6 pt-36 pb-24">
    <div class="max-w-6xl mx-auto w-full grid lg:grid-cols-2 gap-20 items-start">
      <!-- Left -->
      <div>
        <p data-reveal class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase mb-5">Contact</p>
        <h1
          data-reveal
          style="transition-delay:80ms"
          class="text-4xl md:text-5xl font-bold text-white tracking-tight leading-tight mb-7"
        >
          Let's build<br class="hidden sm:block" /> something good.
        </h1>
        <p
          data-reveal
          style="transition-delay:160ms"
          class="text-[#666] text-lg leading-relaxed max-w-md mb-12"
        >
          I'm selective about what I take on, but I'm always open to a
          conversation about interesting problems, strong teams, and ambitious
          products.
        </p>

        <div data-reveal style="transition-delay:240ms" class="flex flex-col gap-4">
          <a
            href="mailto:petarchord@gmail.com"
            class="group inline-flex items-center gap-3 bg-white text-[#09090b] text-sm font-semibold px-6 py-3.5 rounded-lg hover:bg-[#e8e8e8] transition-colors duration-200 w-fit"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            petarchord@gmail.com
          </a>
          <a
            href="tel:+381645477689"
            class="inline-flex items-center gap-3 border border-white/10 text-white text-sm font-medium px-6 py-3.5 rounded-lg hover:border-white/20 hover:bg-white/[0.04] transition-colors duration-200 w-fit"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.62 3h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 10.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17.92Z"/>
            </svg>
            +381 64 547 7689
          </a>
        </div>
      </div>

      <!-- Right: context -->
      <div data-reveal style="transition-delay:200ms" class="space-y-8 pt-2 lg:pt-16">
        <div class="border border-white/[0.06] rounded-xl p-7 hover:border-white/[0.10] transition-colors duration-300">
          <p class="text-[#444] text-xs font-mono tracking-widest uppercase mb-4">What I'm looking for</p>
          <ul class="space-y-3">
            {[
              'Senior or Staff frontend roles',
              'Complex products at scale',
              'Teams that care about craft',
              'Remote or hybrid (Serbia-based)',
            ].map(item => (
              <li class="flex gap-3 text-sm text-[#777]">
                <span class="text-[#818cf8] mt-0.5 shrink-0">›</span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="border border-white/[0.06] rounded-xl p-7 hover:border-white/[0.10] transition-colors duration-300">
          <p class="text-[#444] text-xs font-mono tracking-widest uppercase mb-4">Response time</p>
          <p class="text-[#666] text-sm leading-relaxed">
            I typically respond within 24–48 hours. If it's urgent, mention it in the subject line.
          </p>
        </div>

        <div class="border border-white/[0.06] rounded-xl p-7 hover:border-white/[0.10] transition-colors duration-300">
          <p class="text-[#444] text-xs font-mono tracking-widest uppercase mb-4">Location</p>
          <p class="text-[#666] text-sm">Niš, Serbia</p>
          <p class="text-[#444] text-xs font-mono mt-1">UTC+1 (CET) / UTC+2 (CEST)</p>
        </div>
      </div>
    </div>
  </section>
</PortfolioLayout>
