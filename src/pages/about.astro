---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';

const skills = [
  { category: 'Languages', items: ['TypeScript', 'JavaScript'] },
  { category: 'Frontend', items: ['React.js', 'Next.js', 'Gatsby.js'] },
  { category: 'State', items: ['Redux', 'Redux Toolkit', 'Redux Thunk'] },
  { category: 'Backend', items: ['Node.js', 'Express.js'] },
  { category: 'Databases', items: ['PostgreSQL', 'MongoDB', 'MySQL'] },
  { category: 'Testing', items: ['RTL', 'Jest', 'Stryker.js', 'Jasmine'] },
  { category: 'Infra', items: ['Docker', 'AWS', 'GitHub CI/CD'] },
  { category: 'Tooling', items: ['Vite', 'Webpack', 'ESLint', 'Prettier', 'Husky'] },
];
---

<PortfolioLayout
  title="About — Petar Jovanovic"
  description="Senior Software Engineer with 7+ years of experience in frontend engineering, design systems, and scalable software."
>
  <!-- Header -->
  <section class="pt-36 pb-20 px-6">
    <div class="max-w-6xl mx-auto grid lg:grid-cols-[1fr_300px] gap-16 lg:gap-24 items-start">
      <!-- Bio -->
      <div>
        <p data-reveal class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase mb-5">About</p>
        <h1
          data-reveal
          style="transition-delay:80ms"
          class="text-4xl md:text-5xl font-bold text-white tracking-tight leading-tight mb-10"
        >
          Building things that last.
        </h1>

        <div data-reveal style="transition-delay:160ms" class="space-y-5 text-[#777] text-base leading-relaxed max-w-xl">
          <p>
            I'm Petar, a Senior Software Engineer based in Niš, Serbia. I've spent the past 7+ years 
            focused on frontend engineering—building the kind of software that's still maintainable 
            long after the initial sprint is over.
          </p>
          <p>
            I've worked across both enterprise and startup environments, delivering production software 
            for Fortune Global 500 companies and early-stage teams alike. My work spans fintech, 
            enterprise accounting, e-commerce, social networks, HR, affiliate marketing, and entertainment.
          </p>
          <p>
            I care about the craft. Not just writing code that works, but designing systems that scale—
            for the product and for the teams that maintain it. That means investing in shared component 
            libraries, clean architecture, developer experience, and code quality that holds up under pressure.
          </p>
          <p>
            Outside of engineering, I'm a singer in a band. I believe creativity in one domain 
            sharpens your thinking in another.
          </p>
        </div>

        <!-- Resume download -->
        <div data-reveal style="transition-delay:240ms" class="mt-10 flex flex-wrap gap-3">
          <a
            href="/resume.pdf"
            download
            class="inline-flex items-center gap-2.5 bg-white text-[#09090b] text-sm font-semibold px-6 py-3 rounded-lg hover:bg-[#e8e8e8] transition-colors duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Download CV
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2.5 border border-white/10 text-white text-sm font-medium px-6 py-3 rounded-lg hover:border-white/20 hover:bg-white/[0.04] transition-colors duration-200"
          >
            Get in touch
          </a>
        </div>
      </div>

      <!-- Portrait + contact -->
      <div data-reveal style="transition-delay:200ms" class="space-y-8">
        <figure class="w-full aspect-[4/5] rounded-2xl overflow-hidden bg-[#101013] border border-white/[0.06]">
          <!-- Add your portrait at /public/portrait.jpg -->
          <img
            src="/portrait.jpg"
            alt="Petar Jovanovic"
            class="w-full h-full object-cover object-top"
          />
        </figure>

        <!-- Quick contact -->
        <div class="space-y-3 pt-2">
          <a
            href="mailto:petarchord@gmail.com"
            class="flex items-center gap-3 text-[#666] hover:text-white text-sm transition-colors duration-200 group"
          >
            <svg class="text-[#818cf8] shrink-0" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            petarchord@gmail.com
          </a>
          <a
            href="tel:+381645477689"
            class="flex items-center gap-3 text-[#666] hover:text-white text-sm transition-colors duration-200"
          >
            <svg class="text-[#818cf8] shrink-0" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.62 3h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 10.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 17.92Z"/>
            </svg>
            +381 64 547 7689
          </a>
          <p class="flex items-center gap-3 text-[#666] text-sm">
            <svg class="text-[#818cf8] shrink-0" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            Niš, Serbia
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Principles (abbreviated) -->
  <section class="px-6 py-24 border-t border-white/[0.06] bg-[#0a0a0d]">
    <div class="max-w-6xl mx-auto">
      <p data-reveal class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase mb-4">Philosophy</p>
      <h2 data-reveal style="transition-delay:80ms" class="text-2xl md:text-3xl font-bold text-white tracking-tight mb-12">
        How I build software.
      </h2>
      <div class="grid md:grid-cols-2 gap-px bg-white/[0.06]">
        {[
          { title: 'Think in systems.', body: 'Architecture over individual features. Good systems outlive any single implementation.' },
          { title: 'Ship with purpose.', body: 'Every technical decision should solve a real business problem.' },
          { title: 'Simplicity scales.', body: 'The best software usually removes complexity instead of adding it.' },
          { title: 'AI accelerates engineers.', body: 'I use AI every day—but engineering judgment is still the competitive advantage.' },
        ].map(({ title, body }, i) => (
          <div
            data-reveal
            style={`transition-delay:${i * 60}ms`}
            class="bg-[#0a0a0d] p-8 hover:bg-[#0d0d11] transition-colors duration-300"
          >
            <h3 class="text-white font-semibold text-base mb-2">{title}</h3>
            <p class="text-[#666] text-sm leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="px-6 py-24 border-t border-white/[0.06]">
    <div class="max-w-6xl mx-auto">
      <p data-reveal class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase mb-4">Technical Skills</p>
      <h2 data-reveal style="transition-delay:80ms" class="text-2xl md:text-3xl font-bold text-white tracking-tight mb-12">
        Tools of the trade.
      </h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10">
        {skills.map(({ category, items }, i) => (
          <div data-reveal style={`transition-delay:${i * 60}ms`}>
            <p class="text-[#444] text-xs font-mono tracking-widest uppercase mb-4">{category}</p>
            <ul class="space-y-2">
              {items.map(item => (
                <li class="text-[#777] text-sm hover:text-[#aaa] transition-colors duration-200">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Education -->
  <section class="px-6 py-20 border-t border-white/[0.06]">
    <div class="max-w-6xl mx-auto">
      <p data-reveal class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase mb-10">Education</p>
      <div
        data-reveal
        class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-7 border border-white/[0.06] rounded-xl hover:border-white/[0.10] transition-colors duration-300"
      >
        <div>
          <p class="text-white font-semibold text-base">University of Niš — Faculty of Electronic Engineering</p>
          <p class="text-[#666] text-sm mt-1">Bachelor's Degree in Computer Science</p>
        </div>
        <span class="text-[#444] text-xs font-mono shrink-0">Graduated 2020</span>
      </div>
    </div>
  </section>
</PortfolioLayout>

