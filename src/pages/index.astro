---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import PaayedLogo from '../assets/Paayed-logo.png';
import InditexLogo from '../assets/Inditex-logo.webp';
import FinqueryLogo from '../assets/Finquery-logo.webp';
import SymphonyLogo from '../assets/Symphony-logo.png';
import DevtechLogo from '../assets/Devtech-logo.png';
import NuliaLogo from '../assets/Nulia-logo.png';

// type: 'solid'       = coloured/dark artwork on a white background
// type: 'transparent' = white artwork on a transparent background
const logos = [
  { name: 'Paayed',    src: PaayedLogo.src,   type: 'solid' },
  { name: 'Inditex',   src: InditexLogo.src,  type: 'solid' },
  { name: 'FinQuery',  src: FinqueryLogo.src, type: 'transparent' },
  { name: 'Symphony',  src: SymphonyLogo.src, type: 'transparent' },
  { name: 'Devtech',   src: DevtechLogo.src,  type: 'transparent' },
  { name: 'Nulia',     src: NuliaLogo.src,    type: 'solid' },
];

const stats = [
  { value: '7+', label: 'Years of experience' },
  { value: '3', label: 'Startups built from the ground up' },
  { value: '10+', label: 'Production projects' },
  { value: '100K+', label: 'Users impacted' },
];

const companies = ['Paayed', 'Inditex', 'FinQuery', 'Symphony', 'Devtech'];

const principles = [
  {
    title: 'Think in systems.',
    body: 'Every feature matters, but the architecture behind it determines how well the product grows. I build with the bigger picture in mind, so today’s decisions don’t become tomorrow’s technical debt.',
  },
  {
    title: 'Ship with purpose.',
    body: 'Every technical decision should solve real problems and create value for both users and the business. The best engineering moves the product forward, not just the codebase.',
  },
  {
    title: 'Simplicity scales.',
    body: 'The best solutions remove unnecessary complexity, making products easier to build, maintain, and evolve. Simplicity isn’t cutting corners, it’s making the right trade-offs.',
  },
  {
    title: 'AI accelerates engineers.',
    body: 'AI helps me move faster, explore ideas, and automate repetitive work. Engineering judgment, product thinking, and experience are what turn that speed into great software.',
  },
];

const selectedWork = [
  {
    label: 'Fintech · Component Systems',
    company: 'Paayed',
    description:
      'Designed and led the frontend architecture for an all-in-one B2B fintech platform serving UK SMEs—from design system foundations to secure payment flows.',
    outcomes: [
      '90+ components standardized',
      'Single source of truth for UI',
      'Faster feature delivery across teams',
      'Compliant with UK acquiring requirements',
    ],
    stack: ['TypeScript', 'React', 'Tailwind', 'Radix UI', 'Jest'],
    href: '/work#paayed',
  },
  {
    label: 'Enterprise · Micro-Frontends',
    company: 'Symphony',
    description:
      'Delivered a Micro-Frontend platform and shared npm component library adopted by 10+ engineering teams at a Fortune Global 500 company.',
    outcomes: [
      '10+ teams on shared library',
      'Consistent design across all MFEs',
      'Reduced duplication at scale',
    ],
    stack: ['TypeScript', 'React', 'Jest', 'Stryker.js', 'Docker', 'AWS'],
    href: '/work#symphony',
  },
  {
    label: 'Enterprise · Financial Software',
    company: 'Devtech',
    description:
      'Modernized a legacy accounting platform and built complex D3.js big-data visualizations for a Microsoft 365 adoption platform used by thousands of organizations.',
    outcomes: [
      'High-performance financial reporting',
      'Complex data visualizations at scale',
      'Lease accounting workflows delivered',
    ],
    stack: ['TypeScript', 'Next.js', 'D3.js', 'Redux Toolkit', 'PostgreSQL', 'AWS'],
    href: '/work#devtech',
  },
];

const highlights = [
  {
    icon: '◈',
    title: 'Component Libraries',
    body: 'Building reusable design systems and component libraries that scale across multiple teams. From Storybook documentation to visual regression testing.',
  },
  {
    icon: '⬡',
    title: 'Frontend Architecture',
    body: 'Designing scalable React applications with clean data flows, Micro-Frontend patterns, and codebases that are maintainable as teams grow.',
  },
  {
    icon: '◎',
    title: 'Performance & Accessibility',
    body: "Core Web Vitals, virtualization for large datasets, lazy loading, and ARIA-compliant interfaces. Speed and inclusivity aren't trade-offs.",
  },
  {
    icon: '⟡',
    title: 'AI-Assisted Development',
    body: 'Daily use of Cursor, Claude, and GitHub Copilot—treating AI as a force multiplier, not a replacement for senior engineering judgment.',
  },
];

const tech = [
  'React', 'TypeScript', 'Next.js', 'Node.js', 'Astro',
  'Tailwind', 'PostgreSQL', 'Docker', 'GitHub Actions', 'AWS', 'Storybook', 'Testing',
];
---

<PortfolioLayout>
  <!-- ─── Hero ──────────────────────────────────────────────── -->
  <section class="min-h-[100svh] flex items-center px-6 pt-28 pb-20">
    <div class="max-w-6xl mx-auto w-full grid lg:grid-cols-[1fr_360px] gap-16 lg:gap-24 items-center">
      <!-- Text -->
      <div>
        <p
          data-reveal
          class="text-[#555] text-xs font-mono tracking-[0.25em] uppercase mb-8"
        >
          Sr. Software Engineer | Sass Specialist | AI Enthusiast
        </p>
        <h1
          data-reveal
          style="transition-delay:80ms"
          class="text-[clamp(2.4rem,5.5vw,4rem)] font-bold text-white leading-[1.08] tracking-[-0.025em] mb-7"
        >
          Building scalable products that grow with your business.
		  <!-- <br class="hidden sm:block" /> -->
          <!-- not just beautiful interfaces. -->
        </h1>
        <p
          data-reveal
          style="transition-delay:160ms"
          class="text-[#888] text-lg leading-relaxed max-w-[520px] mb-10"
        >
          I’ve spent the last 7+ years building software for industry leaders, including platforms for Fortune Global 500 companies spanning fintech, ed-tech, social networking, and e-commerce.
        </p>
        <div data-reveal style="transition-delay:240ms" class="flex flex-wrap gap-3">
          <a
            href="/work"
            class="bg-white text-[#09090b] text-sm font-semibold px-6 py-3 rounded-lg hover:bg-[#e8e8e8] transition-colors duration-200"
          >
            View my work
          </a>
          <a
            href="/contact"
            class="border border-white/10 text-white text-sm font-medium px-6 py-3 rounded-lg hover:border-white/20 hover:bg-white/[0.04] transition-colors duration-200"
          >
            Let's talk
          </a>
        </div>
      </div>

      <!-- Portrait -->
      <div data-reveal style="transition-delay:320ms" class="hidden lg:block">
        <figure class="w-full aspect-[4/5] rounded-2xl overflow-hidden bg-[#101013] border border-white/[0.06]">
          <!-- Add your portrait at /public/portrait.jpg -->
          <img
            src="/portrait.jpg"
            alt="Petar Jovanovic"
            class="w-full h-full object-cover object-top"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- ─── Social Proof ─────────────────────────────────────── -->
  <section class="border-t border-white/[0.06] px-6 py-20">
    <div class="max-w-6xl mx-auto">
      <!-- Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-10 mb-14">
        {stats.map(({ value, label }, i) => (
          <div data-reveal style={`transition-delay:${i * 60}ms`}>
            <p class="text-3xl md:text-4xl font-bold text-white tracking-tight mb-1">{value}</p>
            <p class="text-[#555] text-sm">{label}</p>
          </div>
        ))}
      </div>

      <!-- Worked with: logo marquee -->
      <div data-reveal class="mt-4">
        <p class="text-center text-[#3f3f46] text-xs font-mono tracking-[0.25em] uppercase mb-10">
          Worked with
        </p>

        <!-- Full-width marquee — clips overflow + gradient edge fade -->
        <div
          class="marquee-outer relative overflow-hidden"
          style="mask-image: linear-gradient(to right, transparent 0%, black 14%, black 86%, transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 14%, black 86%, transparent 100%);"
        >
          <!-- Track: two identical copies for a seamless infinite loop -->
          <div class="marquee-track flex w-max items-center gap-0">
            {[...logos, ...logos].map((logo, i) => (
              <div class="flex items-center shrink-0" key={i}>
                <img
                  src={logo.src}
                  alt={logo.name}
                  class={`logo-${logo.type}`}
                  draggable="false"
                />
                <!-- Separator between logos -->
                <span
                  class="text-[#1e1e22] select-none px-10 text-xs"
                  aria-hidden="true"
                >
                  /
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Philosophy ───────────────────────────────────────── -->
  <section class="px-6 py-32">
    <div class="max-w-6xl mx-auto">
      <div data-reveal class="mb-14">
        <p class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase mb-4">How I build software</p>
        <h2 class="text-3xl md:text-[2.5rem] font-bold text-white tracking-tight leading-tight">
          Engineering principles.
        </h2>
      </div>

      <!-- Divider-grid pattern (gap-px on parent, bg-white/6 shows as divider) -->
      <div class="grid md:grid-cols-2 gap-px bg-white/[0.06]">
        {principles.map(({ title, body }, i) => (
          <div
            data-reveal
            style={`transition-delay:${i * 80}ms`}
            class="bg-[#09090b] p-8 lg:p-10 hover:bg-[#0c0c0f] transition-colors duration-300"
          >
            <h3 class="text-white font-semibold text-lg mb-3">{title}</h3>
            <p class="text-[#666] text-sm leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Selected Work ────────────────────────────────────── -->
  <section class="px-6 py-32 bg-[#0a0a0d]">
    <div class="max-w-6xl mx-auto">
      <div data-reveal class="flex items-end justify-between mb-14">
        <div>
          <p class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase mb-4">Selected Work</p>
          <h2 class="text-3xl md:text-[2.5rem] font-bold text-white tracking-tight leading-tight">
            What I've built.
          </h2>
        </div>
        <a
          href="/work"
          class="hidden md:flex items-center gap-1.5 text-[#555] hover:text-white text-sm transition-colors duration-200 pb-1"
        >
          All projects
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="space-y-4">
        {selectedWork.map(({ label, company, description, outcomes, stack, href }, i) => (
          <a
            href={href}
            data-reveal
            style={`transition-delay:${i * 80}ms`}
            class="group block border border-white/[0.06] rounded-xl p-7 lg:p-8 hover:border-white/[0.12] hover:bg-white/[0.02] transition-all duration-300"
          >
            <div class="flex flex-col lg:flex-row lg:items-start gap-8">
              <!-- Left: info -->
              <div class="flex-1 min-w-0">
                <p class="text-[#444] text-xs font-mono mb-3">{label}</p>
                <h3 class="text-white font-semibold text-xl mb-3 group-hover:text-[#818cf8] transition-colors duration-200">
                  {company}
                </h3>
                <p class="text-[#666] text-sm leading-relaxed mb-6">{description}</p>
                <div class="flex flex-wrap gap-2">
                  {stack.map((t) => (
                    <span class="text-[11px] text-[#555] border border-white/[0.06] px-2.5 py-1 rounded-md font-mono">
                      {t}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Right: outcomes -->
              <ul class="shrink-0 space-y-2 lg:text-right">
                {outcomes.map((o) => (
                  <li class="flex lg:justify-end items-start gap-2 text-sm text-[#666]">
                    <span class="text-[#818cf8] text-xs mt-1 lg:hidden">↗</span>
                    <span>{o}</span>
                    <span class="text-[#818cf8] text-xs mt-1 hidden lg:inline">↗</span>
                  </li>
                ))}
              </ul>
            </div>
          </a>
        ))}
      </div>

      <div data-reveal class="mt-6 md:hidden">
        <a href="/work" class="text-sm text-[#555] hover:text-white transition-colors duration-200">
          View all projects →
        </a>
      </div>
    </div>
  </section>

  <!-- ─── Engineering Highlights ───────────────────────────── -->
  <section class="px-6 py-32">
    <div class="max-w-6xl mx-auto">
      <div data-reveal class="mb-14">
        <p class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase mb-4">Engineering Highlights</p>
        <h2 class="text-3xl md:text-[2.5rem] font-bold text-white tracking-tight leading-tight">
          What I do well.
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        {highlights.map(({ icon, title, body }, i) => (
          <div
            data-reveal
            style={`transition-delay:${i * 80}ms`}
            class="border border-white/[0.06] rounded-xl p-8 hover:border-white/[0.10] hover:bg-white/[0.02] transition-all duration-300"
          >
            <span class="text-[#818cf8] text-xl block mb-5" aria-hidden="true">{icon}</span>
            <h3 class="text-white font-semibold text-lg mb-3">{title}</h3>
            <p class="text-[#666] text-sm leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Tech ─────────────────────────────────────────────── -->
  <section class="border-t border-white/[0.06] px-6 py-20">
    <div class="max-w-6xl mx-auto">
      <p data-reveal class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase mb-8">Tech</p>
      <div data-reveal class="flex flex-wrap gap-3">
        {tech.map((t) => (
          <span class="text-sm text-[#666] border border-white/[0.06] px-4 py-2 rounded-lg hover:border-white/[0.12] hover:text-[#aaa] transition-colors duration-200">
            {t}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── Contact CTA ──────────────────────────────────────── -->
  <section class="px-6 py-32 text-center">
    <div class="max-w-2xl mx-auto">
      <p data-reveal class="text-[#444] text-xs font-mono tracking-[0.25em] uppercase mb-6">Get in touch</p>
      <h2
        data-reveal
        style="transition-delay:80ms"
        class="text-3xl md:text-[2.5rem] font-bold text-white tracking-tight leading-tight mb-6"
      >
        Open to the right opportunity.
      </h2>
      <p
        data-reveal
        style="transition-delay:160ms"
        class="text-[#666] text-base leading-relaxed mb-10"
      >
        I'm selective about what I take on—but I'm always happy to have a conversation
        about interesting problems, great teams, or ambitious products.
      </p>
      <div data-reveal style="transition-delay:240ms" class="flex flex-wrap gap-3 justify-center">
        <a
          href="/contact"
          class="bg-white text-[#09090b] text-sm font-semibold px-6 py-3 rounded-lg hover:bg-[#e8e8e8] transition-colors duration-200"
        >
          Let's talk
        </a>
        <a
          href="mailto:petarchord@gmail.com"
          class="border border-white/10 text-white text-sm font-medium px-6 py-3 rounded-lg hover:border-white/20 hover:bg-white/[0.04] transition-colors duration-200"
        >
          petarchord@gmail.com
        </a>
      </div>
    </div>
  </section>
</PortfolioLayout>

